---
/**
 * Blog post page: breadcrumb, title, standfirst, lead image, body, and links to
 * the previous and next posts. Post details come from src/data/posts.ts; the body
 * goes in the default slot.
 */
import { Image } from 'astro:assets';
import DraftPage from '../components/draft/DraftPage.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { siteHref } from '../config/draft';
import { getPost, posts } from '../data/posts';

interface Props {
	slug: string;
}

const post = getPost(Astro.props.slug);
const index = posts.indexOf(post);
const prev = posts[index - 1];
const next = posts[index + 1];
const postHref = (slug: string) => siteHref(`/blog/${slug}/`);
---

<DraftPage title={`${post.title} | Andrew Smith`} description={post.standfirst} ogType="article">
	<article>
		<header class="draft-article-hero">
			<Breadcrumb
				items={[
					{ label: 'Home', href: siteHref('/') },
					{ label: 'Blog', href: siteHref('/#blog') },
					{ label: post.title },
				]}
			/>
			<h1 class="display-title">{post.title}</h1>
			<p class="draft-standfirst">{post.standfirst}</p>
		</header>

		<figure class="draft-lead-figure">
			<Image
				class="draft-lead-image"
				src={post.image}
				alt={post.alt}
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 80rem) 78rem, calc(100vw - 3rem)"
				loading="eager"
			/>
		</figure>

		<div class="draft-article">
			<slot />
		</div>
	</article>

	<nav class="draft-related-posts" aria-labelledby="more-posts-heading">
		<h2 id="more-posts-heading">More from the blog</h2>
		<div class="draft-pager">
			{
				prev && (
					<a class="draft-pager-link draft-pager-prev" href={postHref(prev.slug)}>
						<span class="draft-pager-dir">&larr; Previous</span>
						<span class="draft-pager-title">{prev.title}</span>
					</a>
				)
			}
			{
				next && (
					<a class="draft-pager-link draft-pager-next" href={postHref(next.slug)}>
						<span class="draft-pager-dir">Next &rarr;</span>
						<span class="draft-pager-title">{next.title}</span>
					</a>
				)
			}
		</div>
	</nav>
</DraftPage>
