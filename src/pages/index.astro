---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { projects } from '../data/projects';
---
<Layout
  title="Andrew Smith | UX Design Leader & Senior Product Designer"
  description="Portfolio of Andrew Smith, UX designer and team manager based in Adelaide. Twenty years across product design, front-end development, and design leadership."
>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="page">
    <SiteHeader />
    <main id="main-content">
      <section class="hero" id="top">
        <div class="hero-copy">
          <h1 class="display-title">Hi, I'm Andrew. Senior UX designer and team manager based in Adelaide.</h1>
          <p class="hero-text">
            Twenty years across product design, front-end development, and leading UX teams.
            I care about how design practice is structured, how teams make evidence-based decisions,
            and how good work gets delivered consistently.
          </p>
          <p class="hero-note">
            Most interested in the problems underneath the interface.
          </p>
        </div>
      </section>

      <section class="works-list" aria-label="Project list">
        {projects.map((project) => (
          <article class="work-card">
            <div class="work-copy">
              <p class="work-name">{project.name}</p>
              <h2>{project.title}</h2>
              <p class="work-description">{project.description}</p>
              <div class="actions">
                <a href={project.href}>
                  <span>View case study</span>
                  <span aria-hidden="true">-&gt;</span>
                </a>
              </div>
            </div>
            <a class="work-visual" href={project.href}>
              <Image
                class={project.imageClass}
                src={project.image}
                alt={project.alt}
                loading="lazy"
                decoding="async"
                widths={[640, 960, 1280]}
                sizes="(max-width: 860px) 100vw, 55vw"
              />
            </a>
          </article>
        ))}
      </section>
    </main>
    <SiteFooter />
  </div>
</Layout>
<style>
  .page {
    position: relative;
    width: min(calc(100% - 3rem), 78rem);
    margin: 0 auto;
    padding: 1.25rem 0 5rem;
  }
  .hero { padding: 4rem 0 1rem; }
  .display-title {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    max-width: 28ch;
    margin: 0 0 1.25rem;
  }
  .hero-text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--muted-foreground);
    max-width: 38rem;
    margin: 0 0 0.75rem;
  }
  .hero-note {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--muted-foreground);
    font-style: italic;
    max-width: 38rem;
  }
  .works-list { display: grid; gap: 1.5rem; margin-top: 3rem; }
  .work-card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 1.1fr);
    gap: 2rem;
    align-items: start;
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 1.5rem;
  }
  .work-copy { display: grid; align-content: start; gap: 0.8rem; }
  .work-name {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin: 0;
  }
  .work-card h2 {
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 0;
  }
  .work-description { max-width: 34rem; margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--muted-foreground); }
  .actions { display: flex; margin-top: 0.5rem; }
  .actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--foreground);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 2px;
  }
  .actions a:hover { border-bottom-color: var(--foreground); }
  .work-visual {
    display: block;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .project-preview-image { width: 100%; height: auto; display: block; }
  @media(max-width: 860px) {
    .work-card { grid-template-columns: 1fr; }
  }
</style>
