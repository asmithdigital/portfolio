---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { projects } from '../data/projects';
---
<Layout
  title="Andrew Smith | UX Design Leader & Senior Product Designer"
  description="Portfolio of Andrew Smith, UX designer and team manager based in Adelaide. Twenty years across product design, front-end development, and design leadership."
  showFooterCta={true}
>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="page">
    <SiteHeader />
    <main id="main-content">
      <section class="hero" id="top">
        <div class="hero-copy">
          <h1 class="display-title">Hi, I'm Andrew. Senior UX designer and team manager based in Adelaide.</h1>
          <p class="hero-text">
            Twenty years across product design, front-end development, and leading UX teams.
            I care about how design practice is structured, how teams make evidence-based decisions,
            and how good work gets delivered consistently.
          </p>
          <p class="hero-note" id="about">
            Most interested in the problems underneath the interface.
          </p>
        </div>
      </section>

      <section class="projects" id="work">
        <div class="projects-grid">
          {projects.map((project, index) => (
            <a class="project-link" href={project.href}>
              <article class={`project-card ${project.background}`}>
                <div class="project-header">
                  <p class="project-name">{project.name}</p>
                </div>
                <h2 class="project-title">{project.title}</h2>
                <div class={`project-visual ${project.variant}`}>
                  <Image
                    class={project.imageClass}
                    src={project.image}
                    alt={project.alt}
                    loading={index < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                    widths={[480, 720, 960]}
                    sizes="(max-width: 980px) 100vw, 50vw"
                  />
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>
    </main>
  </div>
</Layout>

<style>
  .page {
    position: relative;
    width: min(calc(100% - 3rem), 78rem);
    margin: 0 auto;
    padding: 1.25rem 0 5rem;
  }

  .project-name {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    margin: 0;
    color: var(--muted-foreground);
  }

  .hero {
    padding: 7rem 0 6.5rem;
  }

  .hero-copy {
    width: 100%;
    max-width: 100%;
  }

  .display-title {
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1.06;
    margin: 0 0 0;
    max-width: 18ch;
  }

  .hero-text {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--muted-foreground);
    margin: 1.5rem 0 0;
    max-width: 38rem;
  }

  .hero-note {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--muted-foreground);
    font-style: italic;
    margin: 0.75rem 0 0;
    max-width: 38rem;
  }

  .projects {
    display: grid;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .project-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .project-card {
    border-radius: 1.5rem;
    padding: 1.5rem 1.5rem 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: transform 120ms ease, box-shadow 120ms ease;
    min-height: 22rem;
  }

  .project-link:hover .project-card {
    transform: translateY(-2px);
    box-shadow: 0 16px 40px rgba(23,23,23,0.12);
  }

  .project-card.lime   { background: #d4f5b0; }
  .project-card.cyan   { background: #b0eaf5; }
  .project-card.lavender { background: #d0c8f5; }
  .project-card.mint   { background: #b0f0d8; }

  .project-card .project-name { color: rgba(23,23,23,0.55); }
  .project-card.cyan .project-title,
  .project-card.mint .project-title { color: #171717; }

  .project-title {
    font-size: clamp(1rem, 1.4vw, 1.3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 0;
    color: #171717;
    max-width: 22ch;
  }

  .project-visual {
    margin-top: auto;
    overflow: hidden;
    border-radius: 0.75rem 0.75rem 0 0;
    flex: 1;
    display: flex;
    align-items: flex-end;
  }

  .project-preview-image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0.75rem 0.75rem 0 0;
    object-fit: cover;
    object-position: top center;
    max-height: 260px;
  }

  @media(max-width: 860px) {
    .projects-grid { grid-template-columns: 1fr; }
    .hero { padding: 4rem 0 3rem; }
  }
</style>
