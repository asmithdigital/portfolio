---
import { Image } from 'astro:assets';
import DraftPage from '../components/draft/DraftPage.astro';
import DoubleDiamondCard from '../components/DoubleDiamondCard.astro';
import PostCard from '../components/PostCard.astro';
import { siteHref } from '../config/draft';
import { caseStudies } from '../data/caseStudies';
import { moreWork } from '../data/moreWork';
import { posts } from '../data/posts';
import profilePhoto from '../assets/images/profile-1.png';
import quoteScreen from '../assets/images/QTB-motor.png';

// Only these case studies get a large tile. Other work is listed under More work.
const featuredSlugs = ['travel', 'quote-to-buy'];
const featured = caseStudies.filter((study) => featuredSlugs.includes(study.slug));
---

<DraftPage
	title="Andrew Smith | UX and product designer"
	description="Andrew Smith, UX and product designer in Adelaide. I work with product managers and engineers to find the real problem, test ideas with people, and measure what changed."
>
	<section class="draft-intro draft-home-grid" aria-labelledby="draft-title">
		<Image
			class="draft-photo"
			src={profilePhoto}
			alt="Portrait of Andrew Smith"
			widths={[224, 448]}
			sizes="14rem"
			loading="eager"
		/>
		<div>
			<h1 class="display-title" id="draft-title">Hi, I'm Andrew. I'm a UX and product designer.</h1>
			<p class="hero-text">
				I work with product managers and engineers to find out what is really going wrong for people, test ideas
				before they are built, and measure whether the change worked.
			</p>
			<p class="hero-text">
				I started in front-end development and web design, so I think about how things get built, as well as how
				they work for people.
			</p>
		</div>
	</section>

	<section class="draft-home-section" id="case-studies" aria-labelledby="case-studies-heading">
		<h2 class="draft-section-heading" id="case-studies-heading">Case studies</h2>
		<p class="draft-section-lead">
			Full write-ups are on the way. Each one follows the same process I use on every project.
		</p>
		<div class="projects-grid projects-grid-2">
			{
				featured.map((study) => (
					<a class="project-link" href={siteHref(`/case-studies/${study.slug}/`)}>
						<article class={`project-card ${study.background}`}>
							<div class="project-header">
								<p class="project-name">{study.label}</p>
								<p class="project-badge">Coming soon</p>
							</div>
							<h3 class="project-title">{study.title}</h3>
							<p class="project-teaser">{study.teaser}</p>
							<div class="project-visual">
								<Image
									class="project-preview-image"
									src={study.image}
									alt={study.alt}
									loading="lazy"
									decoding="async"
									widths={[400, 640, 960]}
									sizes="(min-width: 861px) 50vw, 100vw"
								/>
							</div>
						</article>
					</a>
				))
			}
		</div>
		<div class="projects-grid projects-grid-2 projects-grid-small">
			{
				moreWork.map((item) => (
					<article class="project-card project-card-plain">
						<h3 class="project-title">{item.title}</h3>
						<p class="project-teaser">{item.blurb}</p>
						<div class="project-visual">
							{item.image ? (
								<Image
									class="project-preview-image"
									src={item.image}
									alt={item.alt ?? ''}
									loading="lazy"
									decoding="async"
									widths={[400, 640, 800]}
									sizes="(min-width: 861px) 50vw, 100vw"
								/>
							) : (
								<div class="project-visual-placeholder" aria-hidden="true">
									{item.title}
								</div>
							)}
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section class="draft-home-section" aria-labelledby="process-heading">
		<h2 class="draft-section-heading" id="process-heading">How I work</h2>
		<div class="work-grid">
			<article class="draft-card post-card work-card">
				<div
					class="post-card-thumb work-card-diagram"
					role="img"
					aria-label="Double diamond diagram: two diamonds side by side, labelled Discovery and Delivery."
				>
					<DoubleDiamondCard />
				</div>
				<div>
					<h3 class="post-card-title">
						<a class="draft-card-link" href={siteHref('/process/')}>Process</a>
					</h3>
					<p class="post-card-intro">Six stages, from kickoff through to measuring and learning.</p>
					<span class="draft-card-more" aria-hidden="true">Read more &rarr;</span>
				</div>
			</article>
			<article class="draft-card post-card work-card">
				<Image
					class="post-card-thumb"
					src={quoteScreen}
					alt="Car insurance quote form at step 2 of 4, asking how the car is used and how far it drives each year."
					widths={[240, 480]}
					sizes="(min-width: 48rem) 240px, 35vw"
					loading="lazy"
					decoding="async"
				/>
				<div>
					<h3 class="post-card-title">
						<a class="draft-card-link" href={siteHref('/ui-design/')}>UI design</a>
					</h3>
					<p class="post-card-intro">A sample of the finished screens I have designed for websites, stores and apps.</p>
					<span class="draft-card-more" aria-hidden="true">Read more &rarr;</span>
				</div>
			</article>
		</div>
	</section>

	<section class="draft-home-section" id="blog" aria-labelledby="blog-heading">
		<h2 class="draft-section-heading" id="blog-heading">From the blog</h2>
		<ul class="post-list">
			{
				posts.map((post) => (
					<li>
						<PostCard post={post} />
					</li>
				))
			}
		</ul>
	</section>
</DraftPage>
