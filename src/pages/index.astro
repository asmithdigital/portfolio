---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { projects } from '../data/projects';
---
<Layout
  title="Andrew Smith | UX Design Leader & Senior Product Designer"
  description="Portfolio of Andrew Smith, UX designer and team manager based in Adelaide. Twenty years across product design, front-end development, and design leadership."
>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <div class="page">
    <SiteHeader />
    <main id="main-content">
      <section class="hero" id="top">
        <div class="hero-copy">
          <h1 class="display-title">Hi, I'm Andrew. Senior UX designer and team manager based in Adelaide.</h1>
          <p class="hero-text">
            Twenty years across product design, front-end development, and leading UX teams.
            I care about how design practice is structured, how teams make evidence-based decisions,
            and how good work gets delivered consistently.
          </p>
          <p class="hero-note">
            Most interested in the problems underneath the interface.
          </p>
        </div>
      </section>

      <section class="project-grid" aria-label="Work">
        {projects.map((project) => (
          <a class={`project-card project-card--${project.background}`} href={project.href}>
            <div class="project-card-copy">
              <p class="project-card-name">{project.name}</p>
              <h2 class="project-card-title">{project.title}</h2>
              <p class="project-card-desc">{project.description}</p>
            </div>
            <div class="project-card-visual">
              <Image
                class="project-card-img"
                src={project.image}
                alt={project.alt}
                loading="lazy"
                decoding="async"
                widths={[480, 720, 960]}
                sizes="(max-width: 860px) 100vw, 45vw"
              />
            </div>
          </a>
        ))}
      </section>
    </main>
    <SiteFooter />
  </div>
</Layout>
<style>
  .page {
    position: relative;
    width: min(calc(100% - 3rem), 78rem);
    margin: 0 auto;
    padding: 1.25rem 0 5rem;
  }
  .hero { padding: 4rem 0 3rem; }
  .display-title {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.1;
    max-width: 28ch;
    margin: 0 0 1.25rem;
  }
  .hero-text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--muted-foreground);
    max-width: 38rem;
    margin: 0 0 0.6rem;
  }
  .hero-note {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--muted-foreground);
    font-style: italic;
    max-width: 38rem;
  }

  /* Project grid — 2 columns */
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    border-radius: 1.5rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border: 1px solid transparent;
    transition: transform 120ms ease, box-shadow 120ms ease;
  }
  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(23,23,23,0.1);
  }

  /* Card background colours */
  .project-card--lime   { background: #d4f5b0; }
  .project-card--cyan   { background: #b0eaf5; }
  .project-card--lavender { background: #d0c8f5; }
  .project-card--mint   { background: #b0f0d8; }

  .project-card-copy {
    padding: 1.75rem 1.75rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .project-card-name {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(23,23,23,0.55);
    margin: 0;
  }
  .project-card-title {
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 0;
    color: #171717;
  }
  .project-card-desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(23,23,23,0.65);
    margin: 0;
    max-width: 28ch;
  }
  .project-card-visual {
    margin-top: auto;
    overflow: hidden;
    border-radius: 0.75rem 0.75rem 0 0;
    margin: 0.5rem 1rem 0;
  }
  .project-card-img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: top center;
    display: block;
    border-radius: 0.75rem 0.75rem 0 0;
  }

  @media(max-width: 860px) {
    .project-grid { grid-template-columns: 1fr; }
  }
</style>
