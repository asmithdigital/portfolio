---
import { Image } from 'astro:assets';
import DraftPage from '../components/draft/DraftPage.astro';
import { draftHref, draftPracticeLinks, draftThumbnails } from '../config/draft';
import { stages } from '../data/draft/stages';
import { projects } from '../data/projects';
import profilePhoto from '../assets/images/profile-1.png';

const { layout, stages: thumbs } = draftThumbnails;

// Tiles reuse the live home page's project data so images, titles and colours match.
const tiles = draftPracticeLinks.map((link) => {
	const project = projects.find((item) => item.href === link.liveHref);
	if (!project) throw new Error(`No live tile found for ${link.liveHref}`);
	return { ...project, title: link.tileTitle ?? project.title, label: link.label, href: draftHref(link.draftPath) };
});
---

<DraftPage
	title="Andrew Smith | UX designer"
	description="Andrew Smith, UX designer. How I work with product managers and engineers, from framing the work to measuring the result."
>
	<section class="draft-intro draft-home-grid" aria-labelledby="draft-title">
		<Image
			class="draft-photo"
			src={profilePhoto}
			alt="Portrait of Andrew Smith"
			widths={[224, 448]}
			sizes="14rem"
			loading="eager"
		/>
		<div>
			<h1 class="display-title" id="draft-title">Hi, I'm Andrew. I'm a UX designer.</h1>
			<p class="hero-text">
				I work with product managers and engineers to study how people use complex systems. Then I design around what
				I find, rather than guessing.
			</p>
			<p class="hero-text">
				I started in front-end development, so I think about how things get built, as well as how they work for
				people.
			</p>
		</div>
	</section>

	<section class="draft-timeline-section" aria-labelledby="stages-heading">
		<h2 class="draft-section-heading" id="stages-heading">How I work</h2>
		<p class="draft-section-lead">Seven stages, in order.</p>

		<ol
			class="draft-stages"
			style={`--thumb-aspect: ${layout.aspectRatio}; --thumb-width: ${layout.desktopWidth}; --thumb-mobile-width: ${layout.mobileWidth};`}
		>
			{
				stages.map((stage) => {
					const thumb = thumbs[stage.slug];
					return (
						<li class="draft-stage" id={`stage-${stage.slug}`}>
							<span class="draft-stage-dot" aria-hidden="true">
								{stage.number}
							</span>
							<div class="draft-thumb" style={`--thumb-position: ${thumb.position}; --thumb-zoom: ${thumb.zoom};`}>
								<Image
									src={thumb.image}
									alt={thumb.alt}
									widths={[240, 420, 630]}
									sizes="(min-width: 40rem) 210px, 90px"
									loading="lazy"
									decoding="async"
								/>
							</div>
							<h3 class="draft-stage-title">
								<span class="draft-sr-only">Stage {stage.number}: </span>
								{stage.title}
							</h3>
							<div class="draft-stage-body">
								{stage.paragraphs.map((paragraph) => (
									<p>{paragraph}</p>
								))}
							</div>
						</li>
					);
				})
			}
		</ol>
	</section>

	<section class="draft-practices-section" aria-labelledby="practices-heading">
		<h2 class="draft-section-heading" id="practices-heading">Practices</h2>
		<div class="projects-grid">
			{
				tiles.map((tile) => (
					<a class="project-link" href={tile.href}>
						<article class={`project-card ${tile.background}`}>
							<div class="project-header">
								<p class="project-name">{tile.label}</p>
							</div>
							<h3 class="project-title">{tile.title.replace(/\s\u2014\s/, ': ')}</h3>
							<div class={`project-visual ${tile.variant}`}>
								<Image
									class={tile.imageClass}
									src={tile.image}
									alt={tile.alt}
									loading="lazy"
									decoding="async"
									widths={[480, 720, 960]}
									sizes="(max-width: 980px) 100vw, 50vw"
								/>
							</div>
						</article>
					</a>
				))
			}
		</div>
	</section>
</DraftPage>
