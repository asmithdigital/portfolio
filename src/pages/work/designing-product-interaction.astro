.section-heading{font-size:1.3rem;font-weight:700;margin-bottom:.75rem;letter-spacing:-.02em}
.how-to{background:#f0f8f0;border:1px solid #a0d0a0;border-radius:.5rem;padding:.75rem 1rem;font-size:.82rem;color:#2a4a2a;margin-top:.75rem}
.how-to code{background:#d0ead0;padding:.1rem .3rem;border-radius:.2rem;font-family:monospace;font-size:.78rem}
