.scroll-placeholder .item{flex-shrink:0;width:280px;background:#e8e5e0;border-radius:.75rem;height:180px;display:flex;align-items:center;justify-content:center;border:2px dashed #c8c5c0;padding:.75rem;text-align:center}
.scroll-placeholder .item p{color:#999;font-size:.78rem}
.principle{background:#fff;border:1px solid #e0ddd8;border-radius:.75rem;padding:.9rem 1.1rem;margin:.4rem 0;display:grid;grid-template-columns:140px 1fr;gap:1rem;align-items:start}
.principle .name{font-weight:700;font-size:.88rem}
