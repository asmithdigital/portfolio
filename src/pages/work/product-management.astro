---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
---
<Layout title="Product Management Reference — Andrew Smith" description="Personal PM study reference">
  <style>
    .pm-layout{display:grid;grid-template-columns:240px 1fr;min-height:100vh}
    .pm-sidebar{background:#1a1a1a;color:#e0ddd8;padding:2rem 1.5rem;position:sticky;top:0;height:100vh;overflow-y:auto}
    .pm-sidebar h1{font-size:.9rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:#fff;margin-bottom:.25rem}
    .pm-sidebar .meta{font-size:.78rem;color:#666;margin-bottom:2rem}
    .pm-sidebar nav a{display:block;padding:.4rem .75rem;border-radius:.4rem;color:#b0ada8;text-decoration:none;font-size:.82rem;margin-bottom:.1rem;transition:background .15s,color .15s}
    .pm-sidebar nav a:hover,.pm-sidebar nav a.active{background:#333;color:#fff}
    .pm-nav-section{font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#555;margin:1.25rem 0 .4rem .75rem}
    .pm-main{padding:3rem 4rem;max-width:820px}
    .pm-header{margin-bottom:3rem;padding-bottom:2rem;border-bottom:1px solid #e0ddd8}
    .pm-header h1{font-size:2rem;font-weight:700;letter-spacing:-.03em;margin-bottom:.5rem}
    .pm-header p{color:#666;font-size:.9rem;max-width:500px}
    .pm-section{padding:2.5rem 0;border-top:1px solid #e0ddd8}
    .pm-section h2{font-size:1.2rem;font-weight:700;margin-bottom:1.25rem;letter-spacing:-.01em}
    .pm-section h3{font-size:.95rem;font-weight:700;margin:1.5rem 0 .5rem;color:#333}
    .pm-section p{color:#444;margin-bottom:.75rem;max-width:600px;font-size:.93rem}
    .pm-section ul,.pm-section ol{margin:.5rem 0 1rem 1.25rem;color:#444;font-size:.93rem;max-width:600px}
    .pm-section ul li,.pm-section ol li{margin-bottom:.35rem}
    .pm-kicker{font-family:monospace;font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#888;display:block;margin-bottom:.6rem}
    .pm-table{width:100%;border-collapse:collapse;margin:1rem 0 1.5rem;font-size:.88rem}
    .pm-table th{background:#f0ede8;text-align:left;padding:.5rem .75rem;font-weight:700;border-bottom:2px solid #e0ddd8}
    .pm-table td{padding:.5rem .75rem;border-bottom:1px solid #f0ede8;color:#444;vertical-align:top}
    .pm-table tr:last-child td{border-bottom:none}
    .pm-card{background:#fff;border:1px solid #e0ddd8;border-radius:.75rem;padding:1rem 1.25rem;margin:.4rem 0}
    .pm-card .name{font-weight:700;font-size:.9rem;margin-bottom:.25rem}
    .pm-card .desc{font-size:.86rem;color:#555;line-height:1.5}
    .pm-fw{background:#f8f7f4;border:1px solid #e0ddd8;border-radius:.75rem;padding:1.25rem 1.5rem;margin:1rem 0}
    .pm-fw-title{font-weight:700;font-size:.88rem;margin-bottom:.75rem;text-transform:uppercase;letter-spacing:.04em;color:#555}
    .pm-fw-row{display:grid;grid-template-columns:80px 1fr;gap:.5rem;padding:.4rem 0;border-bottom:1px solid #e0ddd8;font-size:.88rem}
    .pm-fw-row:last-child{border-bottom:none}
    .pm-fw-row .key{font-weight:700;color:#1a1a1a}
    .pm-fw-row .val{color:#555}
    .pm-gl td:first-child{font-weight:700;font-size:.85rem;white-space:nowrap;color:#1a1a1a}
  </style>
  <div class="pm-layout">
    <div class="pm-sidebar">
      <h1>PM Reference</h1>
      <div class="meta">Product Management Fundamentals<br>Udemy — 16 modules</div>
      <nav>
        <div class="pm-nav-section">Foundations</div>
        <a href="#s1">What is PM?</a>
        <a href="#s2">Product Development</a>
        <a href="#s3">Ideas and User Needs</a>
        <a href="#s4">Competitive Analysis</a>
        <div class="pm-nav-section">Discovery</div>
        <a href="#s5">Customer Development</a>
        <a href="#s6">MVPs and Experiments</a>
        <a href="#s7">Conceptualising Solutions</a>
        <div class="pm-nav-section">Delivery</div>
        <a href="#s8">Metrics</a>
        <a href="#s9">Building the Product</a>
        <a href="#s10">Working with People</a>
        <a href="#s11">Technology</a>
        <div class="pm-nav-section">Career</div>
        <a href="#s12">Preparing for PM</a>
        <a href="#s13">Finding a Job</a>
        <a href="#s14">Getting the Job</a>
        <a href="#s15">Starting the Role</a>
        <div class="pm-nav-section">Reference</div>
        <a href="#glossary">Glossary</a>
      </nav>
    </div>
    <div class="pm-main">
      <div class="pm-header">
        <h1>Product Management</h1>
        <p>Personal reference guide compiled from a 16-module Udemy course. Use as a pre-interview refresher or study reference.</p>
      </div>

      <div class="pm-section" id="s1">
        <span class="pm-kicker">Module 1</span>
        <h2>What Is Product Management?</h2>
        <p>A PM is a <strong>communications hub</strong> — not a people manager. They pull input from engineering, design, sales, support, leadership, and users, and turn it into a coherent plan. Accountable for whether the product succeeds, even without direct authority over the people building it.</p>
        <h3>Core PM functions</h3>
        <div class="pm-card"><div class="name">Prioritiser</div><div class="desc">Deciding what gets built next, and what does not.</div></div>
        <div class="pm-card"><div class="name">Researcher</div><div class="desc">Understanding users, competitors, and data.</div></div>
        <div class="pm-card"><div class="name">Presenter</div><div class="desc">Communicating plans and rationale to different audiences.</div></div>
        <div class="pm-card"><div class="name">Owner of outcomes</div><div class="desc">Accountable for the product's success even without direct authority.</div></div>
        <h3>Three types of PM</h3>
        <table class="pm-table">
          <tr><th>Type</th><th>Who you build for</th><th>Key characteristics</th></tr>
          <tr><td>Internal PM</td><td>Other teams inside your company</td><td>Lower risk, deep tech knowledge, great first PM role</td></tr>
          <tr><td>B2B / SaaS PM</td><td>Other companies</td><td>Revenue-driven, client deadlines, close sales collaboration</td></tr>
          <tr><td>B2C PM</td><td>General public</td><td>Large user bases, high uncertainty, heavy testing and data reliance</td></tr>
        </table>
        <h3>PM vs. Project Manager</h3>
        <p>A <strong>Product Manager</strong> is responsible for a goal measured by metrics. A <strong>Project Manager</strong> is responsible for delivering a defined project against a fixed timeline, with the "what" already decided. Good PMs still need project management skill, but their real job is defining the right goal, not just hitting a deadline.</p>
      </div>

      <div class="pm-section" id="s2">
        <span class="pm-kicker">Module 2</span>
        <h2>Product Development Fundamentals</h2>
        <h3>Product lifecycle — 4 phases</h3>
        <table class="pm-table">
          <tr><th>Phase</th><th>What is happening</th></tr>
          <tr><td>Introduction</td><td>Just launched, little competition, usually losing money</td></tr>
          <tr><td>Growth</td><td>Market acceptance, rising sales, few competitors, active improvement</td></tr>
          <tr><td>Maturity</td><td>Sales peak, competitors flood in, harder to differentiate</td></tr>
          <tr><td>Decline</td><td>Market saturates, sales fall, product may be phased out</td></tr>
        </table>
        <h3>Development philosophies</h3>
        <div class="pm-card"><div class="name">Lean</div><div class="desc">Ruthlessly cut unnecessary work until you are certain it is needed. Do not build until you have validated interest.</div></div>
        <div class="pm-card"><div class="name">Agile</div><div class="desc">Break work into small batches, ship one at a time, adapt based on feedback rather than planning everything upfront.</div></div>
        <div class="pm-card"><div class="name">Waterfall</div><div class="desc">Plan and build all features together in one long sequential pass. Right when a product cannot function with partial capability.</div></div>
        <h3>Scrum vs Kanban</h3>
        <p><strong>Scrum</strong> uses fixed-length sprints (typically 2 weeks) with sprint planning, daily standups, and retrospectives. <strong>Kanban</strong> is looser — cards move across columns with no fixed sprint cycle. More flexible but harder to forecast velocity.</p>
      </div>

      <div class="pm-section" id="s3">
        <span class="pm-kicker">Module 3</span>
        <h2>Ideas and User Needs</h2>
        <h3>Where PM ideas come from — E.M.U.C.</h3>
        <div class="pm-fw">
          <div class="pm-fw-row"><span class="key">E</span><span class="val">Employees — coworkers, management, yourself</span></div>
          <div class="pm-fw-row"><span class="key">M</span><span class="val">Metrics — problems surfaced by usage data</span></div>
          <div class="pm-fw-row"><span class="key">U</span><span class="val">Users — direct feedback via forums, email, social media</span></div>
          <div class="pm-fw-row"><span class="key">C</span><span class="val">Clients — mainly relevant for B2B PMs</span></div>
        </div>
        <p>The PM is not "the idea person." Their real job is gathering ideas from everywhere and deciding what to build and when.</p>
        <h3>Getting to the real need</h3>
        <p>People ask for a solution they have imagined, not what they actually need. Technique: <strong>ask "Why?" three times</strong> until you reach the real pain point. The PM mindset: find a solution to a real problem, not fit the problem to a pre-chosen solution.</p>
        <h3>Users vs. customers</h3>
        <p>The customer pays. The user uses it. Customers give feedback about desired features. Users give feedback about usability and friction. You need both feedback streams.</p>
      </div>

      <div class="pm-section" id="s4">
        <span class="pm-kicker">Module 4</span>
        <h2>Competitive and Market Analysis</h2>
        <h3>Four types of competitors</h3>
        <table class="pm-table">
          <tr><th>Type</th><th>Definition</th><th>How to respond</th></tr>
          <tr><td>Direct</td><td>Same target customer, same problem</td><td>Be genuinely competitive</td></tr>
          <tr><td>Indirect</td><td>Same problem, different approach</td><td>Do not lose too much share</td></tr>
          <tr><td>Potential</td><td>Same target customer, different problem</td><td>Make sure they cannot easily expand into your space</td></tr>
          <tr><td>Substitute</td><td>Solves same core problem, very differently</td><td>Be at least as good</td></tr>
        </table>
        <h3>Five criteria for evaluating a competitor</h3>
        <ol>
          <li>Product core — who is building it and how good is their team?</li>
          <li>User base size — bigger bases mean easier press and faster iteration</li>
          <li>Design quality — how strong is their product craft?</li>
          <li>Brand — strong brands command loyalty and can charge more</li>
          <li>Speed — how fast can they ship changes?</li>
        </ol>
      </div>

      <div class="pm-section" id="s5">
        <span class="pm-kicker">Module 5</span>
        <h2>Customer Development</h2>
        <p>A framework for maintaining a continuous, iterative feedback loop with customers. Used for risk mitigation and opportunity recognition.</p>
        <h3>Four types of customer interviews</h3>
        <div class="pm-card"><div class="name">Exploratory</div><div class="desc">Open-ended discovery — understand their world before any solution is proposed.</div></div>
        <div class="pm-card"><div class="name">Validation</div><div class="desc">Test a specific hypothesis — does your solution match their real need?</div></div>
        <div class="pm-card"><div class="name">Satisfaction</div><div class="desc">Check how existing users feel about the current product.</div></div>
        <div class="pm-card"><div class="name">Efficiency</div><div class="desc">Watch them use the product and observe where friction occurs.</div></div>
        <h3>Running the interview correctly</h3>
        <p>The topic is their problem, not your solution. Do not pitch. Do not inject your own opinions. Let the conversation go off-script — that is often where new ideas emerge. Universal prompt: "That is interesting — tell me more."</p>
        <h3>The data diet</h3>
        <p>Interviews are one source. Triangulate across: internal feedback, user-test data, online feedback, analytics, industry news, market trends, and competitor-watching. Never make a major call from a single source.</p>
      </div>

      <div class="pm-section" id="s6">
        <span class="pm-kicker">Module 6</span>
        <h2>Designing and Running Experiments (MVPs)</h2>
        <p>MVP = Minimum Viable Product — the version that lets a team collect the maximum validated learning for the least effort. The point is not to build a small product — it is to run a scientific experiment as cheaply as possible. Guiding mantra: <strong>fail fast.</strong></p>
        <h3>Seven-step MVP process</h3>
        <ol>
          <li>Define your problem and solution hypothesis</li>
          <li>Identify assumptions and find the riskiest one</li>
          <li>Build a specific, testable hypothesis around that assumption</li>
          <li>Establish your Minimum Criteria for Success (MCS)</li>
          <li>Choose which MVP type and strategy to run</li>
          <li>Execute the experiment</li>
          <li>Evaluate and learn from the results</li>
        </ol>
        <h3>Risk and difficulty — what to test first</h3>
        <p>Plot assumptions on two axes: how risky and how hard to test. Test High risk / Low difficulty first. Then High risk / High difficulty. Low risk / Low difficulty if time allows. Low risk / High difficulty — generally skip.</p>
        <h3>Types of MVPs</h3>
        <table class="pm-table">
          <tr><th>Type</th><th>How it works</th></tr>
          <tr><td>Email MVP</td><td>Pitch a fictional feature via email and gauge reaction</td></tr>
          <tr><td>Shadow button</td><td>Button that appears to link to a new feature — measure clicks</td></tr>
          <tr><td>404 / coming soon</td><td>Feature appears live but leads to a waitlist page</td></tr>
          <tr><td>Explainer video</td><td>Tutorial video depicting a not-yet-real feature</td></tr>
          <tr><td>Fake landing page</td><td>Single page pitching benefits, measure conversion</td></tr>
          <tr><td>Concierge service</td><td>Manually deliver the outcome by hand for a small group</td></tr>
          <tr><td>Piecemeal MVP</td><td>Stitch together existing off-the-shelf tools to fake functionality</td></tr>
          <tr><td>Wizard of Oz</td><td>Looks automated to users, but humans perform the steps behind the scenes</td></tr>
        </table>
      </div>

      <div class="pm-section" id="s7">
        <span class="pm-kicker">Module 7</span>
        <h2>Conceptualising the Solution</h2>
        <table class="pm-table">
          <tr><th>Stage</th><th>What it is</th><th>Fidelity</th></tr>
          <tr><td>Wireframe</td><td>Rough structural layout — where content blocks go</td><td>Low</td></tr>
          <tr><td>Mockup</td><td>Static visual design with real colours and detail</td><td>Medium-high</td></tr>
          <tr><td>Prototype</td><td>Clickable and interactive — reveals usability issues in the flow</td><td>High</td></tr>
        </table>
        <p>Guiding principle at the wireframe stage: <strong>function over form.</strong> You are validating structure and flow, not aesthetics.</p>
      </div>

      <div class="pm-section" id="s8">
        <span class="pm-kicker">Module 8</span>
        <h2>Metrics: Defining Success and Measuring Results</h2>
        <h3>What makes a metric good</h3>
        <ol>
          <li>Understandable — everyone on the team can grasp what it means</li>
          <li>A rate or ratio — not just a raw count</li>
          <li>Correlated with the outcome you actually care about</li>
          <li>Changeable — something your team's actions can plausibly move</li>
        </ol>
        <h3>The HEART framework</h3>
        <div class="pm-fw">
          <div class="pm-fw-title">For each dimension define: Goal, Signal, Metric</div>
          <div class="pm-fw-row"><span class="key">H</span><span class="val">Happiness — how happy is the user?</span></div>
          <div class="pm-fw-row"><span class="key">E</span><span class="val">Engagement — how engaged are they in the short term?</span></div>
          <div class="pm-fw-row"><span class="key">A</span><span class="val">Adoption — how many interested people have actually tried the product?</span></div>
          <div class="pm-fw-row"><span class="key">R</span><span class="val">Retention — how many keep coming back long term?</span></div>
          <div class="pm-fw-row"><span class="key">T</span><span class="val">Task success — how well can users complete the most valuable task?</span></div>
        </div>
        <h3>The AARRR / Pirate Metrics framework</h3>
        <div class="pm-fw">
          <div class="pm-fw-row"><span class="key">A</span><span class="val">Acquisition — how are users finding you?</span></div>
          <div class="pm-fw-row"><span class="key">A</span><span class="val">Activation — are they signing up and meaningfully engaging?</span></div>
          <div class="pm-fw-row"><span class="key">R</span><span class="val">Retention — are they coming back?</span></div>
          <div class="pm-fw-row"><span class="key">R</span><span class="val">Referral — are they happy enough to tell others?</span></div>
          <div class="pm-fw-row"><span class="key">R</span><span class="val">Revenue — are you making money from them?</span></div>
        </div>
      </div>

      <div class="pm-section" id="s9">
        <span class="pm-kicker">Module 9</span>
        <h2>Building the Product</h2>
        <h3>Epics and user stories</h3>
        <p>An <strong>epic</strong> is a grouping of features representing a larger initiative — typically anything taking longer than a single sprint. A <strong>user story</strong> is a single unit of buildable functionality: "As a [user], I want [something], so that [outcome]." Acceptance criteria define when a story is done.</p>
        <h3>Prioritisation methods</h3>
        <div class="pm-card"><div class="name">Assumption testing</div><div class="desc">Score each item's riskiness (1–10) and importance (1–10), sum them, sort descending. Test riskiest and most important first.</div></div>
        <div class="pm-card"><div class="name">BUC method</div><div class="desc">Score Business benefit, User benefit, and Cost (each 1–10). Sum the two benefit scores, subtract cost, sort descending.</div></div>
        <div class="pm-card"><div class="name">MoSCoW method</div><div class="desc">Bucket each item as Must / Should / Could / Would not this time. Always clear the Musts first.</div></div>
        <h3>Roadmapping</h3>
        <p>Roadmaps are always somewhat inaccurate but valuable as directional guides. An alternative: bucket work into Near-term / Mid-term / Long-term priority tiers rather than fixed dates.</p>
      </div>

      <div class="pm-section" id="s10">
        <span class="pm-kicker">Module 10</span>
        <h2>Working with People and Stakeholders</h2>
        <h3>Working with engineers</h3>
        <ul>
          <li>Treat spec quality as your responsibility — ambiguous requirements are on the PM</li>
          <li>Have a point of view on where a feature is headed longer-term</li>
          <li>Do the groundwork yourself where possible — checking logs, pulling data</li>
          <li>Take technical debt seriously</li>
          <li>Invite their ideas — do not hand down fully-baked specs with zero room for input</li>
        </ul>
        <h3>Working with designers</h3>
        <ul>
          <li>Give designers real creative latitude — do not dictate the visual solution</li>
          <li>Ask for their actual product opinions, not just execution</li>
          <li>Always lead with the user problem and let solutions come second</li>
        </ul>
        <h3>Working with executives</h3>
        <ul>
          <li>Be brief — two bullet points beat two paragraphs</li>
          <li>Frame everything in terms of business impact — revenue, metrics, risk</li>
          <li>Always explain why you landed on a solution, not just what it is</li>
        </ul>
      </div>

      <div class="pm-section" id="s11">
        <span class="pm-kicker">Module 11</span>
        <h2>Technology for Product Managers</h2>
        <p>You do not need to code, but understanding how common technologies work gives you: a realistic sense of what is buildable, credibility with engineers, and an understanding of the real implications of decisions.</p>
        <div class="pm-card"><div class="name">Front end</div><div class="desc">Everything the user sees and interacts with. HTML (structure), CSS (styling), JavaScript (interactivity).</div></div>
        <div class="pm-card"><div class="name">Back end</div><div class="desc">Servers, databases, and the logic away from the user's screen.</div></div>
        <div class="pm-card"><div class="name">API</div><div class="desc">A messenger that takes a request, tells the underlying system what is being asked for, and returns the result. Public APIs let outside developers pull data. Private APIs are internal only.</div></div>
        <div class="pm-card"><div class="name">Tech stack</div><div class="desc">The complete set of technologies — front end through back end — that make up a given app.</div></div>
        <p style="margin-top:1rem">Learning basic SQL lets a PM pull their own data from a company's database without waiting on an engineer.</p>
      </div>

      <div class="pm-section" id="s12">
        <span class="pm-kicker">Module 12</span>
        <h2>Preparing Yourself for the PM Job</h2>
        <p>There is no PM degree. Demonstrate the mindset through existing experience. Reflect on any past instance where you:</p>
        <ol>
          <li>Had to prioritise among multiple competing tasks</li>
          <li>Talked with users of a product or internal tool</li>
          <li>Gave feedback or reported bugs on any product</li>
          <li>Interacted with a product team — helping gather data or giving feedback</li>
          <li>Coordinated with multiple teams on something</li>
          <li>Improved the efficiency of an existing process</li>
        </ol>
      </div>

      <div class="pm-section" id="s13">
        <span class="pm-kicker">Module 13</span>
        <h2>Looking for a Job in Product Management</h2>
        <ol>
          <li>Inside your own company first — lowest-friction path</li>
          <li>Networking — meet people in PM through local events for referrals</li>
          <li>Job boards and PM-focused newsletters</li>
        </ol>
        <p>Vet the opportunity: does the company actually understand what a PM does? Research the existing product leadership — working under someone with genuine experience accelerates your own learning substantially.</p>
      </div>

      <div class="pm-section" id="s14">
        <span class="pm-kicker">Module 14</span>
        <h2>Getting the Job</h2>
        <h3>Resumes</h3>
        <p>Reframe existing experience in PM-relevant terms and quantify everything. Weak: "I managed marketing campaigns." Strong: "Increased the number of simultaneous campaigns managed by 20% over the course of the year."</p>
        <h3>Answering PM interview questions</h3>
        <ul>
          <li>There is rarely a single correct answer — the interviewer is evaluating your reasoning process</li>
          <li>Always show your work: how you arrived at a conclusion, why, and what alternatives you considered</li>
          <li>Before answering a case question, ask clarifying questions</li>
          <li>Treat every interview as practice for the next one</li>
        </ul>
        <h3>Standing out: build a demonstration project</h3>
        <p>Research the company's product, market, and competitors independently. Put together a mini "how I would approach this" project — wireframes, hypothetical A/B tests, competitive analysis. Send it as a thank-you follow-up. This demonstrates initiative most candidates never take the time to show.</p>
      </div>

      <div class="pm-section" id="s15">
        <span class="pm-kicker">Module 15</span>
        <h2>After You Have Got the Job</h2>
        <ol>
          <li>Schedule 1:1s with each team member — understand their goals and current challenges</li>
          <li>Meet the lead engineer — get a walkthrough of the technologies and biggest technical challenges</li>
          <li>Start talking to actual users — build direct understanding of what matters to them</li>
          <li>Read everything internal you can access — past epics, release notes, sales decks</li>
          <li>Study the existing metrics — what is tracked and what the team plans to track next</li>
          <li>Meet with your manager — clarify expectations and understand their goals and pain points</li>
        </ol>
      </div>

      <div class="pm-section" id="glossary">
        <span class="pm-kicker">Quick reference</span>
        <h2>Glossary</h2>
        <table class="pm-table pm-gl">
          <tr><td>MVP</td><td>Minimum Viable Product — smallest experiment that yields validated learning at least cost</td></tr>
          <tr><td>MCS</td><td>Minimum Criteria for Success — the pre-set bar an experiment must clear</td></tr>
          <tr><td>KPI</td><td>Key Performance Indicator — a metric used to judge success</td></tr>
          <tr><td>Epic</td><td>A grouping of features or work larger than one sprint</td></tr>
          <tr><td>User story</td><td>A single unit of buildable functionality: "As a X, I want Y, so that Z"</td></tr>
          <tr><td>Acceptance criteria</td><td>The specific conditions that define a story as done</td></tr>
          <tr><td>Sprint</td><td>A fixed-length (often 2-week) development iteration in Scrum</td></tr>
          <tr><td>Velocity</td><td>Story points completed per sprint</td></tr>
          <tr><td>Story points</td><td>Relative difficulty rating for a piece of work</td></tr>
          <tr><td>HEART</td><td>Happiness, Engagement, Adoption, Retention, Task success — a metrics framework</td></tr>
          <tr><td>AARRR</td><td>Acquisition, Activation, Retention, Referral, Revenue — the pirate metrics funnel</td></tr>
          <tr><td>Feature table</td><td>Comparison matrix of your product vs. competitors across key dimensions</td></tr>
          <tr><td>Jobs-to-be-done</td><td>Thinking about products in terms of the underlying job customers hire them to do</td></tr>
          <tr><td>Tech stack</td><td>The full set of technologies used to build a product</td></tr>
          <tr><td>API</td><td>Application Programming Interface — lets software request data from another system</td></tr>
          <tr><td>Technical debt</td><td>Shortcuts taken during development that will cost more time to fix later</td></tr>
          <tr><td>E.M.U.C.</td><td>Employees, Metrics, Users, Clients — four sources of PM ideas</td></tr>
          <tr><td>MoSCoW</td><td>Must / Should / Could / Would not — a prioritisation bucketing method</td></tr>
          <tr><td>BUC</td><td>Business benefit, User benefit, Cost — a prioritisation scoring method</td></tr>
        </table>
      </div>
    </div>
  </div>
  <script>
    const links=document.querySelectorAll('.pm-sidebar nav a');
    const sections=document.querySelectorAll('.pm-section[id]');
    const obs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){links.forEach(l=>l.classList.remove('active'));const l=document.querySelector(`.pm-sidebar nav a[href="#${e.target.id}"]`);if(l)l.classList.add('active');}});},{rootMargin:'-10% 0px -75% 0px'});
    sections.forEach(s=>obs.observe(s));
    links.forEach(l=>l.addEventListener('click',e=>{e.preventDefault();document.getElementById(l.getAttribute('href').slice(1))?.scrollIntoView({behavior:'smooth'});}));
  </script>
</Layout>
