pre{background:#1a1a1a;color:#e0ddd8;padding:1.25rem 1.5rem;border-radius:.75rem;overflow-x:auto;margin:1rem 0 1.5rem;font-size:.82rem;line-height:1.6}
pre code{background:none;padding:0;color:inherit}
.tip{background:#f0f8f0;border-left:3px solid #2a7a2a;padding:.75rem 1rem;border-radius:0 .5rem .5rem 0;margin:1rem 0;font-size:.88rem;color:#2a4a2a}
.warn{background:#fff8e8;border-left:3px solid #c08020;padding:.75rem 1rem;border-radius:0 .5rem .5rem 0;margin:1rem 0;font-size:.88rem;color:#5a4010}
.pattern-box{background:#fff;border:1px solid #e0ddd8;border-radius:.75rem;padding:1.25rem 1.5rem;margin:1rem 0 1.5rem}
.pattern-box .label{font-size:.75rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#888;margin-bottom:.75rem}
