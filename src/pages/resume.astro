---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import figmaLogo from '../assets/logos/figma.svg';
import framerLogo from '../assets/logos/framer.svg';
import shopifyLogo from '../assets/logos/shopify.svg';
import webflowLogo from '../assets/logos/webflow.svg';

const tools = [
	{ name: 'Figma', logo: figmaLogo, tone: 'light' },
	{ name: 'Framer', logo: framerLogo, tone: 'dark' },
	{ name: 'Shopify', logo: shopifyLogo, tone: 'light' },
	{ name: 'Webflow', logo: webflowLogo, tone: 'light' },
];
---

<Layout
	title="Resume | Andrew Smith, UX Design Leader & Senior Product Designer"
	description="Resume of Andrew Smith, twenty years across product design, front-end development, design systems, and UX leadership. Based in Adelaide, South Australia."
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page">
		<SiteHeader />

		<main id="main-content">
			<section class="hero">
				<p class="eyebrow">Resume</p>
				<h1 class="display-title">20 years across product design, front-end development, and UX leadership.</h1>
				<div class="hero-subgrid">
					<p class="hero-text">
						Senior product designer and UX leader. Designs end-to-end, builds design systems, runs research operations, and leads teams to deliver consistently.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Snapshot</p>
				</div>
				<div class="story-block">
					<p><strong>Location:</strong> Stirling, South Australia</p>
					<p><strong>Focus:</strong> Product design, UX leadership, design systems</p>
					<p><strong>Contact:</strong> <a href="mailto:asmithdigital@gmail.com">asmithdigital@gmail.com</a> &nbsp;·&nbsp; 0400 895 354</p>
					<p><strong>Portfolio:</strong> <a href="https://asmithdigital.github.io/portfolio">asmithdigital.github.io/portfolio</a></p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Experience</p>
				</div>
				<div class="story-block">
					<p>
						<strong>Manager, Digital UX</strong><br />
						RAA, June 2024 – present
					</p>
					<p>
						Leads the UX practice across product squads and organisational programs. Responsible for design quality, team development, practice frameworks, and governance , including vendor procurement, budget management, and executive presentations to architecture review boards.
					</p>
					<p>
						<strong>Senior UX Design Lead</strong><br />
						RAA, 2019 – June 2024
					</p>
					<p>
						Senior product designer across RAA Travel, My Account, payments, renewals, insurance claims, and identity management. Led end-to-end UX and UI delivery, built Research Operations from scratch, and introduced journey mapping and design system governance to the organisation.
					</p>
					<p>
						<strong>UX Designer & Front-End Developer</strong><br />
						University of Adelaide, 2014 – 2019
					</p>
					<p>
						UX lead and front-end developer across the university website, student portals, and marketing products. Built a custom JavaScript-based design system used by all development teams across the university.
					</p>
					<p>
						<strong>Earlier career</strong><br />
						Viterra · Private Media · Vmedia · asmithdigital · Tower Hotel, 1999 – 2014
					</p>
					<p>
						Web design, front-end development, client management, and digital production across agency, media, and corporate environments.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Skills</p>
				</div>
				<div class="story-block">
					<p>
						<strong>Product Design:</strong> End-to-end UX and UI design, user research, usability testing, journey mapping, information architecture, interaction design, prototyping, accessibility.
					</p>
					<p>
						<strong>Design Systems:</strong> Component library governance, token architecture, documentation, Design Ops, Research Ops.
					</p>
					<p>
						<strong>Journey Management:</strong> Journey mapping, journey management platforms, experience measurement, connecting analytics and research to product prioritisation.
					</p>
					<p>
						<strong>Technical:</strong> HTML, CSS, JavaScript, content management systems, Git, responsive design, AI-assisted workflows.
					</p>
					<p>
						<strong>Leadership:</strong> People management, coaching, stakeholder facilitation, executive presentation, vendor and budget governance.
					</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Tools</p>
				</div>
				<div class="story-block">
					<p>Figma · Jira · Confluence · Miro · UserTesting.com · Optimal Workshop · Adobe CC · GitHub · Claude</p>
				</div>
			</section>

			<section class="editorial-section">
				<div class="section-rail">
					<p class="section-kicker">Study</p>
				</div>
				<div class="story-block">
					<p>Certificate in User Experience , Nielsen Norman Group</p>
					<p>Human Centred Design , thishuman.com</p>
					<p>Product Management , Udemy</p>
					<p>Applied Project Management (Grad. Cert., in progress) , University of Adelaide</p>
					<p>Multimedia Studies (Bachelor) , University of South Australia</p>
				</div>
			</section>
		</main>
	</div>
</Layout>

<style>
	.page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.eyebrow,
	.section-kicker {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.hero {
		padding: 6rem 0 4rem;
	}

	.eyebrow,
	.section-kicker {
		margin: 0;
		color: var(--muted-foreground);
		font-style: normal;
	}

	.hero-subgrid {
		display: grid;
		grid-template-columns: 1fr;
		margin-top: 1.75rem;
	}

	.hero-text,
	.story-block p {
		font-size: 1.08rem;
		line-height: 1.7;
		margin: 0;
	}

	.editorial-section {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2rem;
		padding: 2.5rem 0;
		border-top: 1px solid var(--border);
	}

	.section-rail {
		align-self: start;
	}

	.story-block {
		display: grid;
		gap: 1rem;
		max-width: 52rem;
	}

	.story-block strong {
		color: var(--foreground);
	}

	.tools-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 44rem;
	}

	.tool-card {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 1rem 1.05rem;
		border: 1px solid var(--border);
		border-radius: 1.15rem;
		background: var(--card);
	}

	.tool-mark {
		width: 3rem;
		height: 3rem;
		flex: 0 0 3rem;
		display: grid;
		place-items: center;
		border-radius: 0.9rem;
		background: linear-gradient(
			180deg,
			color-mix(in srgb, var(--muted) 90%, var(--card) 10%) 0%,
			color-mix(in srgb, var(--border) 55%, var(--card) 45%) 100%
		);
		border: 1px solid color-mix(in srgb, var(--border) 88%, var(--background) 12%);
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		color: var(--foreground);
	}

	.tool-mark-dark {
		background: #111111;
		border-color: #111111;
	}

	.tool-logo {
		width: 1.55rem;
		height: 1.55rem;
		display: block;
		object-fit: contain;
	}

	.tool-name {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	@media (max-width: 980px) {
		.hero-subgrid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.page {
			width: min(calc(100% - 1.5rem), 78rem);
			padding-top: 1rem;
		}

		.hero {
			padding: 4rem 0 3rem;
		}

		.editorial-section {
			grid-template-columns: 1fr;
		}

		.hero-text,
		.story-block p {
			font-size: 1.05rem;
		}

		.tools-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
