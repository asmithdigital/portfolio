---
/**
 * A row of captioned images that scrolls sideways (the .scroll-section styles in
 * case-study.css). The track can be focused and scrolled with the arrow keys.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** Names the scrolling region for screen readers, for example "Quote to buy sprint photos". */
	label: string;
	items: { src: ImageMetadata; alt: string; caption: string }[];
}

const { label, items } = Astro.props;
---

<div class="scroll-section">
	<p class="scroll-hint-label" aria-hidden="true">Scroll to see more <span>&rarr;</span></p>
	<div class="image-scroll-track-wrap" role="region" aria-label={label} tabindex="0">
		<div class="image-scroll-track">
			{
				items.map((item) => (
					<figure class="scroll-fig">
						<Image
							class="scroll-img"
							src={item.src}
							alt={item.alt}
							widths={[420, 600, 760]}
							sizes="(max-width: 860px) 300px, 380px"
							loading="lazy"
							decoding="async"
						/>
						<figcaption>{item.caption}</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</div>
