---
/** Breadcrumb trail. The last item is the current page and is not a link. */
interface Props {
	items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav class="draft-breadcrumb" aria-label="Breadcrumb">
	<ol>
		{
			items.map((item) => (
				<li>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}</li>
			))
		}
	</ol>
</nav>
