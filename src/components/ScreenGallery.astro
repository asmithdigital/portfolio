---
/**
 * Bento grid of images that open in a gallery overlay.
 *
 * Each tile is a link to the large image, so the images still open without JavaScript.
 * With JavaScript, the link opens a native <dialog> instead.
 *
 * Keyboard behaviour in the overlay:
 * - Focus moves to the close button on open, and Tab stays inside the overlay.
 * - Left and Right arrows change image. Up and Down arrows scroll a tall image.
 * - Escape closes the overlay, and focus returns to the tile that opened it.
 */
import { getImage, Image } from 'astro:assets';
import type { UiScreen } from '../data/uiScreens';

interface Props {
	screens: UiScreen[];
}

const { screens } = Astro.props;

const LARGE_WIDTH = 1800;

/** Keeps only the widths an image can supply, so nothing is scaled up. */
const widthsFor = (screen: UiScreen, widths: number[]) => {
	const usable = widths.filter((width) => width < screen.image.width);
	return [...usable, Math.min(screen.image.width, widths[widths.length - 1])];
};

const items = await Promise.all(
	screens.map(async (screen) => ({
		...screen,
		fullHref: (
			await getImage({ src: screen.image, width: Math.min(screen.image.width, LARGE_WIDTH), format: 'webp' })
		).src,
	})),
);

const tileSizes = {
	small: '(min-width: 48rem) 25vw, 50vw',
	tall: '(min-width: 48rem) 25vw, 50vw',
	wide: '(min-width: 48rem) 50vw, 100vw',
	large: '(min-width: 48rem) 50vw, 100vw',
};
---

<div class="screen-bento-frame">
	<ul class="screen-bento">
		{
			items.map((item, index) => (
				<li class={`screen-tile screen-tile-${item.size}`}>
					<a class="screen-tile-link" href={item.fullHref} aria-haspopup="dialog" data-gallery-open={index}>
						<Image
							class:list={['screen-tile-image', { 'screen-tile-contain': item.fit === 'contain' }]}
							src={item.image}
							alt={item.alt}
							widths={widthsFor(item, [400, 800, 1200])}
							sizes={tileSizes[item.size]}
							loading="lazy"
							decoding="async"
						/>
					</a>
				</li>
			))
		}
	</ul>
</div>

<dialog class="screen-gallery" aria-label="Screen gallery" data-screen-gallery>
	<div class="screen-gallery-bar">
		<p class="screen-gallery-count" aria-live="polite">
			<span data-gallery-count></span>
			<span class="draft-sr-only" data-gallery-alt></span>
		</p>
		<div class="screen-gallery-controls">
			<button class="screen-gallery-button" type="button" data-gallery-prev>Previous</button>
			<button class="screen-gallery-button" type="button" data-gallery-next>Next</button>
			<button class="screen-gallery-button" type="button" autofocus data-gallery-close>Close</button>
		</div>
	</div>
	<div class="screen-gallery-track" data-gallery-track>
		{
			items.map((item, index) => (
				<figure class="screen-gallery-slide" tabindex="0" aria-label={`Screen ${index + 1} of ${items.length}`} inert>
					<Image
						class="screen-gallery-image"
						style={`--image-width: ${item.image.width}px`}
						src={item.image}
						alt={item.alt}
						widths={widthsFor(item, [800, 1200, LARGE_WIDTH])}
						sizes="(min-width: 72rem) 72rem, 100vw"
						loading="lazy"
						decoding="async"
					/>
				</figure>
			))
		}
	</div>
</dialog>

<style>
	.screen-bento-frame {
		container-type: inline-size;
	}

	.screen-bento {
		--bento-gap: 0.75rem;
		--bento-columns: 2;
		--bento-row: calc((100cqi - (var(--bento-columns) - 1) * var(--bento-gap)) / var(--bento-columns) * 0.72);
		display: grid;
		grid-template-columns: repeat(var(--bento-columns), minmax(0, 1fr));
		grid-auto-rows: var(--bento-row);
		grid-auto-flow: dense;
		gap: var(--bento-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.screen-tile-wide { grid-column: span 2; }
	.screen-tile-tall { grid-row: span 2; }
	.screen-tile-large { grid-column: span 2; grid-row: span 2; }

	/* Same gentle lift as the case study tiles on the home page. */
	.screen-tile-link {
		display: block;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--draft-radius);
		background: var(--muted);
		transition: transform 120ms ease, box-shadow 120ms ease;
	}
	.screen-tile-link:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-medium);
	}

	.screen-tile-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top left;
	}
	.screen-tile-contain {
		padding: 0.75rem;
		object-fit: contain;
		object-position: center;
	}

	/* Overlay */
	:global(html:has(.screen-gallery[open])),
	:global(html:has(.screen-gallery[open]) body) {
		overflow: hidden;
	}

	.screen-gallery {
		width: 100%;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		color: var(--foreground);
		background: var(--background);
	}
	.screen-gallery[open] {
		display: flex;
		flex-direction: column;
	}

	.screen-gallery-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		padding: 0.75rem 1rem;
		border-bottom: 1px solid var(--border);
	}
	.screen-gallery-count {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--muted-foreground);
	}
	.screen-gallery-controls {
		display: flex;
		gap: 0.5rem;
	}
	.screen-gallery-button {
		min-height: 2.75rem;
		padding: 0 0.9rem;
		font: inherit;
		font-weight: 700;
		color: var(--foreground);
		background: var(--card);
		border: 1px solid var(--border-strong);
		border-radius: 0.6rem;
		cursor: pointer;
	}
	.screen-gallery-button:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.screen-gallery-track {
		position: relative;
		display: flex;
		flex: 1;
		min-height: 0;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
	}
	.screen-gallery-slide {
		display: grid;
		flex: 0 0 100%;
		margin: 0;
		padding: 1rem;
		overflow-y: auto;
		scroll-snap-align: center;
		scroll-snap-stop: always;
	}
	.screen-gallery-slide:focus-visible {
		outline-offset: -3px;
	}
	.screen-gallery-image {
		/* Capped at the real pixel width so small images are not scaled up. */
		display: block;
		width: min(100%, var(--image-width), 72rem);
		height: auto;
		margin: auto;
		border: 1px solid var(--border);
		border-radius: var(--draft-radius);
	}

	@media (min-width: 48rem) {
		.screen-bento {
			--bento-gap: 1rem;
			--bento-columns: 4;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.screen-tile-link:hover {
			transform: none;
		}
	}
</style>

<script>
	const gallery = document.querySelector<HTMLDialogElement>('[data-screen-gallery]');

	// Without native dialog support, the tiles stay plain links to the large images.
	if (gallery && typeof gallery.showModal === 'function') {
		const track = gallery.querySelector<HTMLElement>('[data-gallery-track]')!;
		const count = gallery.querySelector<HTMLElement>('[data-gallery-count]')!;
		const altText = gallery.querySelector<HTMLElement>('[data-gallery-alt]')!;
		const close = gallery.querySelector<HTMLButtonElement>('[data-gallery-close]')!;
		const slides = Array.from(track.children) as HTMLElement[];
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		let current = 0;
		let opener: HTMLElement | null = null;
		let scrollTimer: number | undefined;

		const setCurrent = (index: number) => {
			current = index;
			slides.forEach((slide, slideIndex) => {
				slide.inert = slideIndex !== index;
			});
			count.textContent = `${index + 1} of ${slides.length}`;
			altText.textContent = slides[index].querySelector('img')?.alt ?? '';
		};

		const show = (index: number) => {
			// A swipe check still waiting to run would undo this change before the scroll starts.
			window.clearTimeout(scrollTimer);
			const next = (index + slides.length) % slides.length;
			setCurrent(next);
			track.scrollTo({ left: slides[next].offsetLeft, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
		};

		document.querySelectorAll<HTMLElement>('[data-gallery-open]').forEach((tile) => {
			tile.addEventListener('click', (event) => {
				// Let modified clicks open the image in a new tab as normal.
				if (event.metaKey || event.ctrlKey || event.shiftKey) return;
				event.preventDefault();
				window.clearTimeout(scrollTimer);
				opener = tile;
				const index = Number(tile.dataset.galleryOpen);
				gallery.showModal();
				setCurrent(index);
				track.scrollLeft = slides[index].offsetLeft;
				slides[index].scrollTop = 0;
				close.focus();
			});
		});

		gallery.querySelector('[data-gallery-prev]')?.addEventListener('click', () => show(current - 1));
		gallery.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(current + 1));
		close.addEventListener('click', () => gallery.close());
		gallery.addEventListener('close', () => opener?.focus());

		gallery.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
				event.preventDefault();
				show(current + (event.key === 'ArrowRight' ? 1 : -1));
			} else if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
				event.preventDefault();
				slides[current].scrollBy({ top: event.key === 'ArrowDown' ? 120 : -120 });
			}
		});

		// Keeps the counter right after a swipe, once the track has settled on a slide.
		track.addEventListener(
			'scroll',
			() => {
				window.clearTimeout(scrollTimer);
				scrollTimer = window.setTimeout(() => {
					const index = Math.round(track.scrollLeft / track.clientWidth);
					if (gallery.open && index !== current) setCurrent(index);
				}, 150);
			},
			{ passive: true },
		);
	}
</script>
