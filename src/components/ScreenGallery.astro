---
/**
 * Even grid of image thumbnails that open in a lightbox over the page.
 *
 * Each thumbnail is a link to the large image, so the images still open without
 * JavaScript. See Lightbox.astro for the keyboard behaviour.
 */
import { Image } from 'astro:assets';
import Lightbox from './Lightbox.astro';
import type { UiScreen } from '../data/uiScreens';
import { lightboxImage, widthsFor } from '../utils/images';

interface Props {
	screens: UiScreen[];
}

const { screens } = Astro.props;

const items = await Promise.all(
	screens.map(async (screen) => (screen.placeholder ? screen : { ...screen, large: await lightboxImage(screen.image) })),
);
---

<ul class="screen-grid" data-screen-grid>
	{
		items.map((item, index) =>
			item.placeholder ? (
				<li data-screen-item>
					<div class="screen-placeholder">
						<p class="screen-placeholder-title">{item.title}</p>
						<p class="screen-placeholder-status">{item.status}</p>
					</div>
				</li>
			) : (
				<li data-screen-item>
					<a
						class="screen-thumb"
						href={item.large.src}
						data-lightbox-thumb
						data-title={item.title}
						data-srcset={item.large.srcSet.attribute}
						data-width={item.image.width}
						data-height={item.image.height}
					>
						<Image
							class="screen-thumb-image"
							src={item.image}
							alt={item.alt}
							widths={widthsFor(item.image, [480, 800, 1200])}
							sizes="(min-width: 60rem) 33vw, (min-width: 40rem) 50vw, 100vw"
							loading={index < 3 ? 'eager' : 'lazy'}
							decoding="async"
						/>
					</a>
				</li>
			),
		)
	}
</ul>

<Lightbox />

<style>
	.screen-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--draft-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.screen-thumb,
	.screen-placeholder {
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--draft-radius);
		background: var(--muted);
	}

	/* Same gentle lift as the case study tiles on the home page. */
	.screen-thumb {
		transition: transform 120ms ease, box-shadow 120ms ease;
	}
	.screen-thumb:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-medium);
	}
	.screen-thumb-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}

	.screen-placeholder {
		display: grid;
		place-content: center;
		gap: 0.25rem;
		padding: 1rem;
		text-align: center;
	}
	.screen-placeholder-title {
		margin: 0;
		font-weight: 700;
	}
	.screen-placeholder-status {
		margin: 0;
		font-size: 0.95rem;
		color: var(--muted-foreground);
	}

	@media (min-width: 40rem) {
		.screen-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 60rem) {
		.screen-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.screen-thumb:hover {
			transform: none;
		}
	}
</style>
