---
/**
 * Even grid of image thumbnails that open in a lightbox over the page.
 *
 * Each thumbnail is a link to the large image, so the images still open without
 * JavaScript. The page adds <Lightbox /> once, so several galleries can share it.
 * See Lightbox.astro for the keyboard behaviour.
 *
 * With `captions`, each screen's title is shown under its tile.
 */
import { Image } from 'astro:assets';
import type { UiScreen } from '../data/uiScreens';
import { lightboxImage, widthsFor } from '../utils/images';

interface Props {
	screens: UiScreen[];
	/** Show each title as a caption under its tile. */
	captions?: boolean;
	/** How many tiles load straight away. Use 0 for a gallery below the fold. */
	eagerCount?: number;
}

const { screens, captions = false, eagerCount = 3 } = Astro.props;

const items = await Promise.all(
	screens.map(async (screen) => (screen.placeholder ? screen : { ...screen, large: await lightboxImage(screen.image) })),
);
---

<ul class="screen-grid" data-screen-grid>
	{
		items.map((item, index) =>
			item.placeholder ? (
				<li data-screen-item>
					<div class="screen-placeholder">
						<p class="screen-placeholder-title">{item.title}</p>
						<p class="screen-placeholder-status">{item.status}</p>
					</div>
				</li>
			) : (
				<li data-screen-item>
					<a
						class:list={['screen-thumb', item.fit === 'contain' && 'screen-thumb-contain']}
						href={item.large.src}
						data-lightbox-thumb
						data-title={item.title}
						data-srcset={item.large.srcSet.attribute}
						data-width={item.image.width}
						data-height={item.image.height}
					>
						<Image
							class="screen-thumb-image"
							src={item.image}
							alt={item.alt}
							widths={widthsFor(item.image, [480, 800, 1200])}
							sizes="(min-width: 60rem) 33vw, (min-width: 40rem) 50vw, 100vw"
							loading={index < eagerCount ? 'eager' : 'lazy'}
							decoding="async"
						/>
					</a>
					{captions && <p class="screen-caption">{item.title}</p>}
				</li>
			),
		)
	}
</ul>

<style>
	.screen-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--draft-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.screen-thumb,
	.screen-placeholder {
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--draft-radius);
		background: var(--muted);
	}

	/* Same gentle lift as the case study tiles on the home page. */
	.screen-thumb {
		transition: transform 120ms ease, box-shadow 120ms ease;
	}
	.screen-thumb:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-medium);
	}
	.screen-thumb-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}

	/* Whole image inside the tile, for tall mobile screens. */
	.screen-thumb-contain .screen-thumb-image {
		object-fit: contain;
		object-position: center;
		padding: 0.75rem;
	}

	.screen-caption {
		margin: 0.6rem 0 0;
		font-size: 0.92rem;
		line-height: 1.45;
		color: var(--muted-foreground);
	}

	.screen-placeholder {
		display: grid;
		place-content: center;
		gap: 0.25rem;
		padding: 1rem;
		text-align: center;
	}
	.screen-placeholder-title {
		margin: 0;
		font-weight: 700;
	}
	.screen-placeholder-status {
		margin: 0;
		font-size: 0.95rem;
		color: var(--muted-foreground);
	}

	@media (min-width: 40rem) {
		.screen-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 60rem) {
		.screen-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.screen-thumb:hover {
			transform: none;
		}
	}
</style>
