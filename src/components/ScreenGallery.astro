---
/**
 * Even grid of image thumbnails that open in a lightbox over the page.
 *
 * Each thumbnail is a link to the large image, so the images still open without
 * JavaScript. With JavaScript, the link opens the lightbox instead.
 *
 * Keyboard behaviour in the lightbox:
 * - Focus moves to Close on open, Tab stays inside, and focus returns to the
 *   thumbnail on close.
 * - Left and Right arrows change image. Up and Down arrows scroll a tall image.
 * - Escape, the Close button or a click on the backdrop closes it.
 * On touch screens, swipe left or right to change image.
 */
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { UiScreen } from '../data/uiScreens';

interface Props {
	screens: UiScreen[];
}

const { screens } = Astro.props;

/** Keeps only the widths an image can supply, so nothing is scaled up. */
const widthsFor = (image: ImageMetadata, widths: number[]) => {
	const usable = widths.filter((width) => width < image.width);
	return [...usable, Math.min(image.width, widths[widths.length - 1])];
};

const items = await Promise.all(
	screens.map(async (screen) =>
		screen.placeholder
			? screen
			: { ...screen, large: await getImage({ src: screen.image, widths: widthsFor(screen.image, [800, 1200, 1800, 2400]), format: 'webp' }) },
	),
);

const lightboxSizes = '(min-width: 60rem) calc(100vw - 6rem), (min-width: 48rem) calc(100vw - 4rem), calc(100vw - 2rem)';
---

<ul class="screen-grid" data-screen-grid>
	{
		items.map((item, index) =>
			item.placeholder ? (
				<li data-screen-item>
					<div class="screen-placeholder">
						<p class="screen-placeholder-title">{item.title}</p>
						<p class="screen-placeholder-status">{item.status}</p>
					</div>
				</li>
			) : (
				<li data-screen-item>
					<a
						class="screen-thumb"
						href={item.large.src}
						data-screen-thumb
						data-title={item.title}
						data-srcset={item.large.srcSet.attribute}
						data-width={item.image.width}
						data-height={item.image.height}
					>
						<Image
							class="screen-thumb-image"
							src={item.image}
							alt={item.alt}
							widths={widthsFor(item.image, [480, 800, 1200])}
							sizes="(min-width: 60rem) 33vw, (min-width: 40rem) 50vw, 100vw"
							loading={index < 3 ? 'eager' : 'lazy'}
							decoding="async"
						/>
					</a>
				</li>
			),
		)
	}
</ul>

<dialog class="lightbox" aria-label="Image gallery" data-lightbox data-sizes={lightboxSizes}>
	<div class="lightbox-bar">
		<p class="lightbox-count" aria-hidden="true" data-lightbox-count></p>
		<p class="draft-sr-only" aria-live="polite" data-lightbox-live></p>
		<button class="lightbox-button lightbox-close" type="button" data-lightbox-close>
			Close
			<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"></path></svg>
		</button>
	</div>
	<div class="lightbox-stage" tabindex="0" role="group" aria-label="Current image" data-lightbox-stage></div>
	<button class="lightbox-button lightbox-arrow lightbox-prev" type="button" aria-label="Previous image" data-lightbox-prev>
		<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7"></path></svg>
	</button>
	<button class="lightbox-button lightbox-arrow lightbox-next" type="button" aria-label="Next image" data-lightbox-next>
		<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7"></path></svg>
	</button>
</dialog>

<style>
	.screen-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--draft-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.screen-thumb,
	.screen-placeholder {
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--draft-radius);
		background: var(--muted);
	}

	/* Same gentle lift as the case study tiles on the home page. */
	.screen-thumb {
		transition: transform 120ms ease, box-shadow 120ms ease;
	}
	.screen-thumb:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-medium);
	}
	.screen-thumb-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}

	.screen-placeholder {
		display: grid;
		place-content: center;
		gap: 0.25rem;
		padding: 1rem;
		text-align: center;
	}
	.screen-placeholder-title {
		margin: 0;
		font-weight: 700;
	}
	.screen-placeholder-status {
		margin: 0;
		font-size: 0.95rem;
		color: var(--muted-foreground);
	}

	/* Lightbox. The colours are fixed so it looks the same in light and dark mode. */
	:global(html.lightbox-open),
	:global(html.lightbox-open body) {
		overflow: hidden;
	}

	.lightbox {
		--lightbox-margin: 1rem;
		--lightbox-dim: rgb(10 12 16 / 88%);
		--lightbox-text: #ffffff;
		--lightbox-control: rgb(13 16 20 / 78%);
		--lightbox-control-hover: rgb(13 16 20 / 96%);
		--lightbox-line: rgb(255 255 255 / 55%);
		--ring: #ffffff;
		position: fixed;
		inset: 0;
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: 0;
		overflow: hidden;
		color: var(--lightbox-text);
		background: var(--lightbox-dim);
		border: 0;
		font-family: var(--font-sans);
	}
	.lightbox[open] {
		display: flex;
		flex-direction: column;
		animation: lightbox-fade-in 160ms ease-out;
	}
	.lightbox.is-closing {
		animation: lightbox-fade-out 120ms ease-in forwards;
	}

	.lightbox-bar {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem var(--lightbox-margin);
	}
	.lightbox-count {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 600;
	}

	.lightbox-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		min-width: 2.75rem;
		min-height: 2.75rem;
		font: inherit;
		font-weight: 700;
		color: var(--lightbox-text);
		background: var(--lightbox-control);
		border: 1px solid var(--lightbox-line);
		border-radius: 999px;
		cursor: pointer;
		transition: background-color 120ms ease, border-color 120ms ease;
	}
	.lightbox-button:hover {
		background: var(--lightbox-control-hover);
		border-color: var(--lightbox-text);
	}
	/* The dark edge keeps the white ring visible over a light image. */
	.lightbox-button:focus-visible {
		box-shadow: 0 0 0 6px var(--lightbox-control-hover);
	}
	.lightbox-button svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.lightbox-close {
		padding: 0 0.7rem 0 0.9rem;
	}
	.lightbox-arrow {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
	}
	.lightbox-prev {
		left: 0.25rem;
	}
	.lightbox-next {
		right: 0.25rem;
	}

	/* A wide image fits inside and is centred. A tall one fills the width and scrolls from the top.
	   The script narrows an image that is only slightly too tall, so it fits whole. */
	.lightbox-stage {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		flex: 1;
		min-height: 0;
		padding: 0 var(--lightbox-margin) var(--lightbox-margin);
		overflow: hidden auto;
		overscroll-behavior: contain;
		touch-action: pan-y pinch-zoom;
	}
	.lightbox[open] .lightbox-stage {
		animation: lightbox-settle 160ms ease-out;
	}
	.lightbox-stage:focus-visible {
		outline-offset: -3px;
	}
	.lightbox-stage :global(img) {
		display: block;
		width: min(100%, var(--image-width));
		height: auto;
		margin: auto;
		border-radius: 0.6rem;
		animation: lightbox-fade-in 140ms ease-out;
	}

	@keyframes lightbox-fade-in {
		from {
			opacity: 0;
		}
	}
	@keyframes lightbox-fade-out {
		to {
			opacity: 0;
		}
	}
	@keyframes lightbox-settle {
		from {
			transform: scale(0.985);
		}
	}

	@media (min-width: 48rem) {
		.lightbox {
			--lightbox-margin: 2rem;
		}
	}

	@media (min-width: 40rem) {
		.screen-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 60rem) {
		.screen-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2rem;
		}
		.lightbox {
			--lightbox-margin: 3rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.screen-thumb:hover {
			transform: none;
		}
		.lightbox[open],
		.lightbox.is-closing,
		.lightbox[open] .lightbox-stage,
		.lightbox-stage :global(img) {
			animation: none;
		}
	}
</style>

<script>
	const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');

	// Without native dialog support, the thumbnails stay plain links to the large images.
	if (lightbox && typeof lightbox.showModal === 'function') {
		const root = document.documentElement;
		const thumbs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-screen-thumb]'));
		const stage = lightbox.querySelector<HTMLElement>('[data-lightbox-stage]')!;
		const count = lightbox.querySelector<HTMLElement>('[data-lightbox-count]')!;
		const live = lightbox.querySelector<HTMLElement>('[data-lightbox-live]')!;
		const close = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-close]')!;
		const prev = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-prev]')!;
		const next = lightbox.querySelector<HTMLButtonElement>('[data-lightbox-next]')!;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		const sizes = lightbox.dataset.sizes ?? '';
		const preloaded = new Set<number>();
		const SCROLL_THRESHOLD = 1.2;

		let current = 0;
		let opener: HTMLElement | null = null;
		let closeTimer: number | undefined;
		let touchStart: { x: number; y: number } | null = null;

		const wrap = (index: number) => (index + thumbs.length) % thumbs.length;

		const applySource = (image: HTMLImageElement, thumb: HTMLAnchorElement) => {
			image.sizes = sizes;
			image.srcset = thumb.dataset.srcset ?? '';
			image.src = thumb.href;
		};

		const preload = (index: number) => {
			if (preloaded.has(index)) return;
			preloaded.add(index);
			applySource(new Image(), thumbs[index]);
		};

		/**
		 * An image only slightly too tall for the space fits whole, rather than scrolling a
		 * few pixels. Anything taller keeps the CSS default: full width, scrolling from the top.
		 */
		const fitImage = () => {
			const image = stage.querySelector('img');
			if (!image) return;
			const margin = parseFloat(getComputedStyle(stage).paddingBottom);
			const spaceHeight = stage.clientHeight - margin;
			const fullWidth = Math.min(lightbox.clientWidth - margin * 2, image.width);
			const fullHeight = (fullWidth * image.height) / image.width;
			const fits = fullHeight > spaceHeight && fullHeight <= spaceHeight * SCROLL_THRESHOLD;
			image.style.width = fits ? `${(spaceHeight * image.width) / image.height}px` : '';
		};

		const show = (index: number) => {
			current = wrap(index);
			const thumb = thumbs[current];
			const image = document.createElement('img');
			image.alt = thumb.querySelector('img')?.alt ?? '';
			image.width = Number(thumb.dataset.width);
			image.height = Number(thumb.dataset.height);
			image.style.setProperty('--image-width', `${thumb.dataset.width}px`);
			applySource(image, thumb);

			stage.replaceChildren(image);
			fitImage();
			stage.scrollTop = 0;
			count.textContent = `${current + 1} of ${thumbs.length}`;
			live.textContent = `${thumb.dataset.title}, image ${current + 1} of ${thumbs.length}`;
			preload(wrap(current + 1));
			preload(wrap(current - 1));
		};

		const lockPage = () => {
			// Hiding the scrollbar widens the page, so fill its space to stop a sideways shift.
			const scrollbar = window.innerWidth - root.clientWidth;
			root.classList.add('lightbox-open');
			root.style.paddingRight = scrollbar ? `${scrollbar}px` : '';
		};

		const unlockPage = () => {
			root.classList.remove('lightbox-open');
			root.style.paddingRight = '';
		};

		const open = (index: number, thumb: HTMLElement) => {
			window.clearTimeout(closeTimer);
			lightbox.classList.remove('is-closing');
			opener = thumb;
			lockPage();
			lightbox.showModal();
			show(index);
			close.focus({ preventScroll: true });
		};

		const requestClose = () => {
			if (!lightbox.open || lightbox.classList.contains('is-closing')) return;
			if (reducedMotion.matches) {
				lightbox.close();
				return;
			}
			lightbox.classList.add('is-closing');
			closeTimer = window.setTimeout(() => lightbox.close(), 120);
		};

		thumbs.forEach((thumb, index) => {
			thumb.setAttribute('aria-haspopup', 'dialog');
			thumb.addEventListener('click', (event) => {
				// Let modified clicks open the image in a new tab as normal.
				if (event.metaKey || event.ctrlKey || event.shiftKey) return;
				event.preventDefault();
				open(index, thumb);
			});
		});

		prev.addEventListener('click', () => show(current - 1));
		next.addEventListener('click', () => show(current + 1));
		close.addEventListener('click', requestClose);

		// Escape fires cancel. Hold the native close so the fade can finish.
		lightbox.addEventListener('cancel', (event) => {
			event.preventDefault();
			requestClose();
		});

		lightbox.addEventListener('close', () => {
			lightbox.classList.remove('is-closing');
			stage.replaceChildren();
			unlockPage();
			opener?.focus({ preventScroll: true });
		});

		// A click on anything other than the image, a control or the counter is on the backdrop.
		lightbox.addEventListener('click', (event) => {
			if (event.target instanceof Element && !event.target.closest('img, button, [data-lightbox-count]')) requestClose();
		});

		lightbox.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
				event.preventDefault();
				show(current + (event.key === 'ArrowRight' ? 1 : -1));
			} else if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
				event.preventDefault();
				stage.scrollBy({ top: event.key === 'ArrowDown' ? 120 : -120 });
			} else if (event.key === 'Tab') {
				// Native dialogs let Tab reach the browser's own controls, so keep it inside.
				const stops = [close, stage, prev, next];
				const position = stops.indexOf(document.activeElement as HTMLElement);
				const target = stops[(position + (event.shiftKey ? -1 : 1) + stops.length) % stops.length];
				event.preventDefault();
				target.focus({ preventScroll: true });
			}
		});

		window.addEventListener('resize', () => {
			if (lightbox.open) fitImage();
		});

		// Vertical drags stay with the browser (touch-action: pan-y), so they still scroll the image.
		lightbox.addEventListener(
			'touchstart',
			(event) => {
				touchStart = event.touches.length === 1 ? { x: event.touches[0].clientX, y: event.touches[0].clientY } : null;
			},
			{ passive: true },
		);
		lightbox.addEventListener(
			'touchend',
			(event) => {
				if (!touchStart) return;
				const dx = event.changedTouches[0].clientX - touchStart.x;
				const dy = event.changedTouches[0].clientY - touchStart.y;
				touchStart = null;
				if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(current + (dx < 0 ? 1 : -1));
			},
			{ passive: true },
		);
	}
</script>
