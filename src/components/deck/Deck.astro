---
/**
 * Full-screen slide deck, reusable for any case study. Slide content comes from a
 * data file in src/data/decks/.
 *
 * Desktop (900px and wider, with JavaScript): one 16:9 slide at a time, scaled to
 * fit the window. Right, Down, Space and Page Down go forward; Left, Up, Shift+Space
 * and Page Up go back; Home and End jump to the ends. N shows the speaker notes.
 * The slide number is kept in the URL hash, for example #7.
 *
 * Phones, or without JavaScript: slides stack and scroll, with notes hidden until
 * the Notes button or N is used.
 *
 * Print: landscape, one slide per page, controls and notes hidden.
 */
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { siteHref } from '../../config/draft';
import type { Deck } from '../../data/decks/types';

interface Props {
	deck: Deck;
	/** Where the "Exit" link goes. */
	backHref?: string;
}

const { deck, backHref = siteHref('/') } = Astro.props;
const total = deck.slides.length;
const boxNames = {
	1: 'Problem and success',
	2: 'Who and what we know',
	3: 'Journey and pain',
	4: 'Riskiest assumption and bet',
	5: 'Ideas and screens',
	6: 'Test and measure',
} as const;
const imageSizes = '(min-width: 900px) 640px, 100vw';
---

<Layout title={deck.title} description={deck.description} noindex={true} showFooterCta={false}>
	<div class="deck" data-deck>
		<nav class="deck-controls" aria-label="Slide controls">
			<a class="deck-exit" href={backHref}>Exit</a>
			<div class="deck-controls-main">
				<button type="button" class="deck-btn" data-deck-prev aria-label="Previous slide">&larr;</button>
				<p class="deck-count" aria-live="polite" data-deck-count>1 / {total}</p>
				<button type="button" class="deck-btn" data-deck-next aria-label="Next slide">&rarr;</button>
			</div>
			<button type="button" class="deck-btn deck-notes-btn" data-deck-notes aria-pressed="false">Notes (N)</button>
		</nav>

		<main id="main-content" class="deck-viewport" data-deck-viewport>
			<h1 class="deck-sr-only">{deck.title.split(' | ')[0]}</h1>
			<div class="deck-stage" data-deck-stage>
				{
					deck.slides.map((slide, i) => (
						<section
							class:list={['deck-slide', `deck-layout-${slide.layout}`, slide.box && `deck-box-${slide.box}`]}
							id={`slide-${i + 1}`}
							aria-label={`Slide ${i + 1} of ${total}: ${slide.title}`}
							data-deck-slide
						>
							<div class="deck-frame">
								{(slide.box || slide.eyebrow) && (
									<p class="deck-eyebrow">
										{slide.box ? (
											<>
												<span class="deck-box-num">{slide.box}</span>
												{boxNames[slide.box]}
											</>
										) : (
											slide.eyebrow
										)}
									</p>
								)}

								<div class="deck-body">
									<div class="deck-text">
										<h2 class="deck-title" tabindex="-1">{slide.title}</h2>
										{slide.subtitle && <p class="deck-subtitle">{slide.subtitle}</p>}
										{slide.points && (
											<ul class="deck-points">
												{slide.points.map((point) => (
													<li>{point}</li>
												))}
											</ul>
										)}
										{slide.stats && (
											<dl class="deck-stats">
												{slide.stats.map((stat) => (
													<div>
														<dt>{stat.value}</dt>
														<dd>{stat.label}</dd>
													</div>
												))}
											</dl>
										)}
										{slide.quotes && (
											<div class="deck-quotes">
												{slide.quotes.map((quote) => (
													<figure>
														<blockquote>{quote.text}</blockquote>
														<figcaption>{quote.who}</figcaption>
													</figure>
												))}
											</div>
										)}
										{slide.steps && (
											<ol class="deck-steps">
												{slide.steps.map((step) => (
													<li>
														<span class="deck-step-when">{step.when}</span>
														<span class="deck-step-what">{step.what}</span>
													</li>
												))}
											</ol>
										)}
									</div>

									{slide.images && slide.images.length > 0 && (
										<div class:list={['deck-media', `deck-media-${slide.images.length}`]}>
											{slide.images.map((image, n) => (
												<figure>
													<Image
														src={image.src}
														alt={image.alt}
														widths={[480, 800, 1200]}
														sizes={imageSizes}
														loading={i === 0 && n === 0 ? 'eager' : 'lazy'}
														decoding="async"
													/>
													{image.caption && <figcaption>{image.caption}</figcaption>}
												</figure>
											))}
										</div>
									)}
								</div>

								<footer class="deck-foot">
									{slide.source && <p class="deck-source">{slide.source}</p>}
									<p class="deck-num">{i + 1}</p>
								</footer>
							</div>

							{slide.notes && (
								<aside class="deck-notes" aria-label={`Speaker notes for slide ${i + 1}`}>
									<p class="deck-notes-label">Notes</p>
									<p>{slide.notes}</p>
								</aside>
							)}
						</section>
					))
				}
			</div>
		</main>
	</div>
</Layout>

<style is:global>
	/* ---------- Shared slide styles (stacked mode is the default) ---------- */
	.deck {
		--deck-w: 1280px;
		--deck-h: 720px;
		--box-1: #444444;
		--box-2: #1f5fbf;
		--box-3: #1f5fbf;
		--box-4: #6b43b8;
		--box-5: #6b43b8;
		--box-6: #1d8a4f;
		--deck-accent: var(--foreground);
		font-family: var(--font-sans);
		color: var(--foreground);
		background: var(--muted);
		min-height: 100vh;
	}
	body:has(.deck) .shared-footer { display: none; }
	.deck-sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.deck-controls {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.6rem 1rem;
		background: var(--background);
		border-bottom: 1px solid var(--border);
	}
	.deck-controls-main { display: flex; align-items: center; gap: 0.75rem; }
	.deck-exit { font-weight: 700; text-decoration: none; }
	.deck-btn {
		min-width: 44px;
		min-height: 40px;
		padding: 0 0.8rem;
		border: 1px solid var(--control-border);
		border-radius: 999px;
		font-weight: 700;
		color: var(--foreground);
		cursor: pointer;
	}
	.deck-btn:hover { background: var(--muted); }
	.deck-btn[aria-pressed='true'] { background: var(--foreground); color: var(--background); }
	.deck-count { margin: 0; min-width: 4.5rem; text-align: center; font-variant-numeric: tabular-nums; font-weight: 700; }
	/* Previous and next only make sense one slide at a time. */
	.deck:not(.is-presenting) [data-deck-prev],
	.deck:not(.is-presenting) [data-deck-next],
	.deck:not(.is-presenting) .deck-count { display: none; }

	.deck-viewport { padding: 1rem; }
	.deck-stage { display: grid; gap: 1.25rem; max-width: 64rem; margin: 0 auto; }

	.deck-slide { scroll-margin-top: 4rem; }
	.deck-frame {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding: 1.5rem;
		background: var(--background);
		border: 1px solid var(--border);
		border-radius: 1rem;
		border-top: 6px solid var(--deck-accent);
	}
	.deck-box-1 { --deck-accent: var(--box-1); }
	.deck-box-2 { --deck-accent: var(--box-2); }
	.deck-box-3 { --deck-accent: var(--box-3); }
	.deck-box-4 { --deck-accent: var(--box-4); }
	.deck-box-5 { --deck-accent: var(--box-5); }
	.deck-box-6 { --deck-accent: var(--box-6); }

	.deck-eyebrow {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.deck-box-num {
		display: inline-grid;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 50%;
		background: var(--deck-accent);
		color: #ffffff;
	}
	.deck-body { display: grid; gap: 1.25rem; }
	.deck-title {
		margin: 0;
		font-size: clamp(1.6rem, 5vw, 2.4rem);
		line-height: 1.08;
		letter-spacing: -0.03em;
		font-weight: 800;
	}
	.deck-title:focus { outline: none; }
	.deck-subtitle { margin: 0.75rem 0 0; font-size: 1.1rem; line-height: 1.5; color: var(--muted-foreground); }
	.deck-points { margin: 1rem 0 0; padding-left: 1.2rem; display: grid; gap: 0.6rem; font-size: 1.05rem; line-height: 1.45; }

	.deck-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1rem; margin: 1.25rem 0 0; }
	.deck-stats div { padding: 1rem; border: 1px solid var(--border); border-radius: 0.75rem; border-top: 4px solid var(--deck-accent); }
	.deck-stats dt { font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
	.deck-stats dd { margin: 0.4rem 0 0; font-size: 0.95rem; line-height: 1.4; color: var(--muted-foreground); }

	.deck-quotes { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; margin-top: 1.25rem; }
	.deck-quotes figure { margin: 0; padding: 1rem 1.1rem; border-left: 4px solid var(--deck-accent); background: var(--muted); border-radius: 0.5rem; }
	.deck-quotes blockquote { margin: 0; font-size: 1.1rem; line-height: 1.4; font-weight: 600; }
	.deck-quotes figcaption { margin-top: 0.6rem; font-size: 0.9rem; color: var(--muted-foreground); }

	.deck-steps { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; gap: 0.75rem; }
	.deck-steps li { display: grid; gap: 0.2rem; padding-left: 1rem; border-left: 3px solid var(--foreground); }
	.deck-step-when { font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; }
	.deck-step-what { font-size: 1rem; line-height: 1.4; }

	.deck-media { display: grid; gap: 1rem; }
	.deck-media figure { margin: 0; min-height: 0; display: flex; flex-direction: column; gap: 0.4rem; }
	.deck-media img {
		width: 100%;
		height: auto;
		object-fit: contain;
		border: 1px solid var(--border);
		border-radius: 0.6rem;
		background: #ffffff;
	}
	.deck-media figcaption { font-size: 0.85rem; line-height: 1.35; color: var(--muted-foreground); }

	.deck-foot { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-top: auto; }
	.deck-source { margin: 0; font-size: 0.8rem; color: var(--muted-foreground); }
	.deck-num { margin: 0 0 0 auto; font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted-foreground); }

	.deck-notes { display: none; margin-top: 0.75rem; padding: 1rem 1.2rem; background: var(--background); border: 1px dashed var(--control-border); border-radius: 0.75rem; font-size: 1rem; line-height: 1.55; }
	.deck-notes p { margin: 0; }
	.deck-notes-label { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 0.4rem !important; }
	.deck.show-notes .deck-notes { display: block; }

	/* Title slides */
	.deck-layout-title .deck-title { font-size: clamp(2.2rem, 7vw, 3.6rem); }
	.deck-layout-title .deck-subtitle { font-size: 1.3rem; color: var(--foreground); }

	/* ---------- Present mode: one 16:9 slide at a time, scaled to fit ---------- */
	.deck.is-presenting { height: 100vh; height: 100dvh; display: flex; flex-direction: column; overflow: hidden; }
	.deck.is-presenting .deck-viewport { flex: 1; min-height: 0; padding: 0; position: relative; overflow: hidden; }
	.deck.is-presenting .deck-stage {
		position: absolute;
		top: 0;
		left: 50%;
		width: var(--deck-w);
		max-width: none;
		margin: 0;
		display: block;
		transform-origin: top center;
		transform: translateX(-50%) scale(var(--deck-scale, 1));
	}
	.deck.is-presenting .deck-slide { display: none; }
	.deck.is-presenting .deck-slide.is-active { display: block; }
	.deck.is-presenting .deck-frame {
		width: var(--deck-w);
		height: var(--deck-h);
		padding: 48px 64px 32px;
		gap: 20px;
		border-radius: 18px;
		border-top-width: 10px;
		box-shadow: var(--shadow-medium);
		overflow: hidden;
	}
	.deck.is-presenting .deck-eyebrow { font-size: 15px; }
	.deck.is-presenting .deck-box-num { width: 28px; height: 28px; }
	.deck.is-presenting .deck-body { flex: 1; min-height: 0; grid-template-columns: 1fr; gap: 28px; align-content: start; }
	.deck.is-presenting .deck-title { font-size: 46px; }
	.deck.is-presenting .deck-subtitle { font-size: 22px; margin-top: 16px; }
	.deck.is-presenting .deck-points { font-size: 22px; gap: 12px; margin-top: 22px; }
	.deck.is-presenting .deck-stats dt { font-size: 44px; }
	.deck.is-presenting .deck-stats dd { font-size: 17px; }
	.deck.is-presenting .deck-quotes blockquote { font-size: 21px; }
	.deck.is-presenting .deck-steps { grid-auto-flow: column; grid-auto-columns: 1fr; gap: 14px; margin-top: 40px; }
	.deck.is-presenting .deck-steps li { padding: 14px 0 0; border-left: 0; border-top: 4px solid var(--foreground); }
	.deck.is-presenting .deck-step-when { font-size: 15px; }
	.deck.is-presenting .deck-step-what { font-size: 18px; }
	.deck.is-presenting .deck-source, .deck.is-presenting .deck-num { font-size: 14px; }

	/* Text left, images right */
	.deck.is-presenting .deck-layout-image .deck-body { grid-template-columns: 5fr 6fr; align-items: start; }
	.deck.is-presenting .deck-media { height: 100%; min-height: 0; align-content: start; }
	.deck.is-presenting .deck-layout-image .deck-media-1 img { max-height: 470px; }
	.deck.is-presenting .deck-layout-image .deck-media-2 img { max-height: 215px; }
	/* Headline, then a row of images */
	.deck.is-presenting .deck-layout-images .deck-media { grid-template-columns: repeat(var(--cols, 3), 1fr); align-items: start; }
	.deck.is-presenting .deck-layout-images .deck-media-2 { --cols: 2; }
	.deck.is-presenting .deck-layout-images .deck-media img { max-height: 340px; }
	/* Title slides */
	.deck.is-presenting .deck-layout-title .deck-body { grid-template-columns: 1fr 1fr; align-items: center; height: 100%; }
	.deck.is-presenting .deck-layout-title .deck-title { font-size: 64px; }
	.deck.is-presenting .deck-layout-title .deck-subtitle { font-size: 26px; }
	.deck.is-presenting .deck-layout-title .deck-body:not(:has(.deck-media)) { grid-template-columns: 1fr; align-content: center; }

	/* Notes sit under the slide; the slide shrinks to make room. */
	.deck.is-presenting .deck-notes { width: var(--deck-w); margin-top: 16px; font-size: 20px; max-height: 260px; overflow: auto; }

	@media (prefers-reduced-motion: no-preference) {
		.deck.is-presenting .deck-slide.is-active .deck-frame { animation: deck-in 160ms ease-out; }
	}
	@keyframes deck-in { from { opacity: 0.4; } }

	/* ---------- Print: landscape, one slide per page ---------- */
	@media print {
		@page { size: 297mm 167mm; margin: 0; }
		html, body { background: #ffffff !important; }
		.deck-controls, .deck-notes, .shared-footer, .skip-link, #mcc-banner, #mcc-modal, .mcc-banner, .mcc-modal { display: none !important; }
		.deck, .deck.is-presenting { height: auto; overflow: visible; display: block; background: #ffffff; }
		.deck-viewport, .deck.is-presenting .deck-viewport { padding: 0; overflow: visible; }
		.deck-stage, .deck.is-presenting .deck-stage { position: static; transform: none; width: auto; max-width: none; display: block; }
		.deck-slide, .deck.is-presenting .deck-slide { display: block !important; break-after: page; page-break-after: always; }
		.deck-slide:last-child { break-after: auto; page-break-after: auto; }
		.deck-frame, .deck.is-presenting .deck-frame {
			width: 297mm;
			height: 167mm;
			padding: 12mm 16mm 8mm;
			border: 0;
			border-top: 3mm solid var(--deck-accent);
			border-radius: 0;
			box-shadow: none;
			overflow: hidden;
			animation: none !important;
		}
		.deck-body { grid-template-columns: 1fr; }
		.deck-layout-image .deck-body { grid-template-columns: 5fr 6fr; }
		.deck-layout-images .deck-media { grid-template-columns: repeat(3, 1fr); }
		.deck-layout-images .deck-media-2 { grid-template-columns: repeat(2, 1fr); }
		.deck-layout-title .deck-body { grid-template-columns: 1fr 1fr; align-items: center; }
		.deck-media img { max-height: 95mm; }
		.deck-layout-images .deck-media img { max-height: 80mm; }
		.deck-steps { grid-auto-flow: column; grid-auto-columns: 1fr; }
	}
</style>

<script>
	const deck = document.querySelector<HTMLElement>('[data-deck]');

	if (deck) {
		const slides = Array.from(deck.querySelectorAll<HTMLElement>('[data-deck-slide]'));
		const viewport = deck.querySelector<HTMLElement>('[data-deck-viewport]')!;
		const stage = deck.querySelector<HTMLElement>('[data-deck-stage]')!;
		const count = deck.querySelector<HTMLElement>('[data-deck-count]')!;
		const notesBtn = deck.querySelector<HTMLButtonElement>('[data-deck-notes]')!;
		const wide = window.matchMedia('(min-width: 900px)');
		const BASE_W = 1280;
		const BASE_H = 720;
		let current = 0;

		const fromHash = () => {
			const n = parseInt(location.hash.replace(/\D/g, ''), 10);
			return Number.isFinite(n) && n >= 1 && n <= slides.length ? n - 1 : 0;
		};

		const fit = () => {
			if (!deck.classList.contains('is-presenting')) return;
			const notes = slides[current].querySelector<HTMLElement>('.deck-notes');
			const notesH = deck.classList.contains('show-notes') && notes ? notes.offsetHeight + 16 : 0;
			const availW = viewport.clientWidth - 48;
			const availH = viewport.clientHeight - 32;
			const scale = Math.min(availW / BASE_W, (availH) / (BASE_H + notesH));
			stage.style.setProperty('--deck-scale', String(Math.max(scale, 0.2)));
			stage.style.top = `${Math.max((availH - (BASE_H + notesH) * scale) / 2, 0) + 16}px`;
		};

		const show = (index: number, focus = false) => {
			current = Math.min(Math.max(index, 0), slides.length - 1);
			slides.forEach((slide, i) => slide.classList.toggle('is-active', i === current));
			count.textContent = `${current + 1} / ${slides.length}`;
			history.replaceState(null, '', `#${current + 1}`);
			fit();
			if (focus) slides[current].querySelector<HTMLElement>('.deck-title')?.focus({ preventScroll: true });
		};

		const setMode = () => {
			deck.classList.toggle('is-presenting', wide.matches);
			if (wide.matches) show(fromHash());
			else stage.style.top = '';
		};

		const toggleNotes = () => {
			const on = !deck.classList.contains('show-notes');
			deck.classList.toggle('show-notes', on);
			notesBtn.setAttribute('aria-pressed', String(on));
			fit();
		};

		deck.querySelector('[data-deck-prev]')!.addEventListener('click', () => show(current - 1, true));
		deck.querySelector('[data-deck-next]')!.addEventListener('click', () => show(current + 1, true));
		notesBtn.addEventListener('click', toggleNotes);

		document.addEventListener('keydown', (event) => {
			if (event.metaKey || event.ctrlKey || event.altKey) return;
			const target = event.target as HTMLElement;
			if (target.closest('input, textarea, select, [contenteditable]')) return;
			if (event.key === 'n' || event.key === 'N') {
				event.preventDefault();
				toggleNotes();
				return;
			}
			if (!deck.classList.contains('is-presenting')) return;
			const forward = ['ArrowRight', 'ArrowDown', 'PageDown'].includes(event.key) || (event.key === ' ' && !event.shiftKey);
			const back = ['ArrowLeft', 'ArrowUp', 'PageUp'].includes(event.key) || (event.key === ' ' && event.shiftKey);
			if (target.closest('button, a') && event.key === ' ') return;
			if (forward) { event.preventDefault(); show(current + 1, true); }
			else if (back) { event.preventDefault(); show(current - 1, true); }
			else if (event.key === 'Home') { event.preventDefault(); show(0, true); }
			else if (event.key === 'End') { event.preventDefault(); show(slides.length - 1, true); }
		});

		// Load every image before printing, so lazy images appear in the PDF.
		window.addEventListener('beforeprint', () => {
			deck.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => (img.loading = 'eager'));
		});

		window.addEventListener('hashchange', () => { if (deck.classList.contains('is-presenting')) show(fromHash()); });
		window.addEventListener('resize', fit);
		wide.addEventListener('change', setMode);
		setMode();
	}
</script>
