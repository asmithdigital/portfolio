---
/**
 * Header for the hidden draft: name plus one Practices dropdown.
 *
 * Keyboard behaviour:
 * - The desktop dropdown is a native <details>: Enter or Space opens and closes.
 *   Escape closes it and returns focus to its button. Clicking outside or
 *   tabbing away closes it.
 * - On small screens the menu opens full screen, traps focus while open,
 *   and closes on Escape with focus returned to the menu button.
 * - Without JavaScript, all menus still open and close natively.
 */
import { siteConfig } from '../../config/site';
import { draftHref, draftPracticeLinks, publicHref } from '../../config/draft';

const normalise = (path: string) => path.replace(/\/$/, '');
const currentPath = normalise(Astro.url.pathname);
const homeHref = draftHref('/');
const chevronSrc = publicHref('icons/chevron-down.svg');

const menus = [
	{
		id: 'practices',
		label: 'Practices',
		links: draftPracticeLinks.map((link) => ({ href: draftHref(link.draftPath), label: link.label })),
	},
];

const isCurrent = (href: string) => normalise(href) === currentPath;
---

<header class="shared-header draft-header">
	<a class="shared-brand" href={homeHref} aria-current={isCurrent(homeHref) ? 'page' : undefined}>
		<span class="shared-brand-mark">{siteConfig.name}</span>
	</a>

	<div class="shared-header-actions">
		<nav class="shared-nav shared-nav-desktop draft-nav" aria-label="Primary">
			{
				menus.map((menu) => (
					<details class="draft-menu" data-draft-menu>
						<summary class="draft-menu-trigger">
							{menu.label}
							<img src={chevronSrc} alt="" width="14" height="14" />
						</summary>
						<ul class="draft-menu-panel">
							{menu.links.map((link) => (
								<li>
									<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</details>
				))
			}
		</nav>

		<button
			class="shared-theme-toggle"
			type="button"
			data-theme-toggle
			aria-label="Switch to dark mode"
			aria-pressed="false"
		>
			<span class="shared-theme-toggle-icons" aria-hidden="true">
				<svg
					class="shared-theme-icon shared-theme-icon-sun"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<circle cx="12" cy="12" r="4.25"></circle>
					<path d="M12 2.75v2.5"></path>
					<path d="M12 18.75v2.5"></path>
					<path d="M21.25 12h-2.5"></path>
					<path d="M5.25 12h-2.5"></path>
					<path d="M18.54 5.46l-1.77 1.77"></path>
					<path d="M7.23 16.77l-1.77 1.77"></path>
					<path d="M18.54 18.54l-1.77-1.77"></path>
					<path d="M7.23 7.23L5.46 5.46"></path>
				</svg>
				<svg
					class="shared-theme-icon shared-theme-icon-moon"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M20.2 14.35A8.75 8.75 0 1 1 9.65 3.8 7 7 0 0 0 20.2 14.35Z"></path>
				</svg>
			</span>
		</button>

		<details class="shared-nav-mobile" data-draft-mobile-menu>
			<summary class="shared-nav-toggle" aria-label="Menu">
				<span class="shared-nav-toggle-box" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</span>
			</summary>

			<nav class="shared-mobile-panel" aria-label="Mobile">
				<a class="shared-mobile-brand" href={homeHref}>{siteConfig.name}</a>
				{
					menus.map((menu) => (
						<details class="shared-mobile-submenu">
							<summary class="shared-mobile-submenu-trigger">
								{menu.label}
								<img src={chevronSrc} alt="" width="14" height="14" />
							</summary>
							<ul class="shared-mobile-submenu-panel draft-mobile-list">
								{menu.links.map((link) => (
									<li>
										<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</details>
					))
				}
			</nav>
		</details>
	</div>
</header>

<script>
	const desktopMenus = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-draft-menu]'));

	const closeMenu = (menu: HTMLDetailsElement, returnFocus = false) => {
		if (!menu.open) return;
		menu.open = false;
		if (returnFocus) menu.querySelector('summary')?.focus();
	};

	desktopMenus.forEach((menu) => {
		menu.addEventListener('toggle', () => {
			if (!menu.open) return;
			desktopMenus.filter((other) => other !== menu).forEach((other) => closeMenu(other));
		});

		menu.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.open) {
				event.preventDefault();
				closeMenu(menu, true);
			}
		});

		menu.addEventListener('focusout', (event) => {
			const next = event.relatedTarget;
			if (next instanceof Node && menu.contains(next)) return;
			closeMenu(menu);
		});
	});

	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Node)) return;
		desktopMenus.filter((menu) => !menu.contains(target)).forEach((menu) => closeMenu(menu));
	});

	const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-draft-mobile-menu]');

	if (mobileMenu) {
		const root = document.documentElement;
		const toggle = mobileMenu.querySelector<HTMLElement>('.shared-nav-toggle');
		const lockClass = 'shared-mobile-menu-open';

		const focusable = () =>
			Array.from(mobileMenu.querySelectorAll<HTMLElement>('a[href], summary')).filter(
				(item) => item.offsetParent !== null,
			);

		mobileMenu.addEventListener('toggle', () => {
			root.classList.toggle(lockClass, mobileMenu.open);
		});

		mobileMenu.addEventListener('keydown', (event) => {
			if (!mobileMenu.open) return;

			if (event.key === 'Escape') {
				event.preventDefault();
				mobileMenu.open = false;
				toggle?.focus();
				return;
			}

			if (event.key !== 'Tab') return;

			const items = focusable();
			const first = items[0];
			const last = items[items.length - 1];
			if (!first || !last) return;

			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		});

		mobileMenu.addEventListener('click', (event) => {
			if (event.target instanceof Element && event.target.closest('a[href]')) {
				mobileMenu.open = false;
			}
		});

		window.addEventListener('pagehide', () => root.classList.remove(lockClass));
	}
</script>
