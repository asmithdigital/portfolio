---
/**
 * Site header: name, menu links and the dark mode toggle.
 *
 * Keyboard behaviour:
 * - On small screens the menu opens full screen, traps focus while open,
 *   and closes on Escape with focus returned to the menu button.
 * - Without JavaScript, the mobile menu still opens and closes natively.
 */
import { siteConfig } from '../../config/site';
import { navLinks, siteHref } from '../../config/draft';

const normalise = (path: string) => path.replace(/\/$/, '');
const currentPath = normalise(Astro.url.pathname);
const homeHref = siteHref('/');

const isCurrent = (href: string) => normalise(href) === currentPath;
---

<header class="shared-header draft-header">
	<a class="shared-brand" href={homeHref} aria-current={isCurrent(homeHref) ? 'page' : undefined}>
		<span class="shared-brand-mark">{siteConfig.name}</span>
	</a>

	<div class="shared-header-actions">
		<nav class="shared-nav shared-nav-desktop draft-nav" aria-label="Primary">
			{
				navLinks.map((link) => (
					<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
						{link.label}
					</a>
				))
			}
		</nav>

		<button
			class="shared-theme-toggle"
			type="button"
			data-theme-toggle
			aria-label="Switch to dark mode"
			aria-pressed="false"
		>
			<span class="shared-theme-toggle-icons" aria-hidden="true">
				<svg
					class="shared-theme-icon shared-theme-icon-sun"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<circle cx="12" cy="12" r="4.25"></circle>
					<path d="M12 2.75v2.5"></path>
					<path d="M12 18.75v2.5"></path>
					<path d="M21.25 12h-2.5"></path>
					<path d="M5.25 12h-2.5"></path>
					<path d="M18.54 5.46l-1.77 1.77"></path>
					<path d="M7.23 16.77l-1.77 1.77"></path>
					<path d="M18.54 18.54l-1.77-1.77"></path>
					<path d="M7.23 7.23L5.46 5.46"></path>
				</svg>
				<svg
					class="shared-theme-icon shared-theme-icon-moon"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M20.2 14.35A8.75 8.75 0 1 1 9.65 3.8 7 7 0 0 0 20.2 14.35Z"></path>
				</svg>
			</span>
		</button>

		<details class="shared-nav-mobile" data-draft-mobile-menu>
			<summary class="shared-nav-toggle" aria-label="Menu">
				<span class="shared-nav-toggle-box" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</span>
			</summary>

			<nav class="shared-mobile-panel" aria-label="Mobile">
				<a class="shared-mobile-brand" href={homeHref}>{siteConfig.name}</a>
				{
					navLinks.map((link) => (
						<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
							{link.label}
						</a>
					))
				}
			</nav>
		</details>
	</div>
</header>

<script>
	const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-draft-mobile-menu]');

	if (mobileMenu) {
		const root = document.documentElement;
		const toggle = mobileMenu.querySelector<HTMLElement>('.shared-nav-toggle');
		const lockClass = 'shared-mobile-menu-open';

		const focusable = () =>
			Array.from(mobileMenu.querySelectorAll<HTMLElement>('a[href], summary')).filter(
				(item) => item.offsetParent !== null,
			);

		mobileMenu.addEventListener('toggle', () => {
			root.classList.toggle(lockClass, mobileMenu.open);
		});

		mobileMenu.addEventListener('keydown', (event) => {
			if (!mobileMenu.open) return;

			if (event.key === 'Escape') {
				event.preventDefault();
				mobileMenu.open = false;
				toggle?.focus();
				return;
			}

			if (event.key !== 'Tab') return;

			const items = focusable();
			const first = items[0];
			const last = items[items.length - 1];
			if (!first || !last) return;

			if (event.shiftKey && document.activeElement === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && document.activeElement === last) {
				event.preventDefault();
				first.focus();
			}
		});

		mobileMenu.addEventListener('click', (event) => {
			if (event.target instanceof Element && event.target.closest('a[href]')) {
				mobileMenu.open = false;
			}
		});

		window.addEventListener('pagehide', () => root.classList.remove(lockClass));
	}
</script>
